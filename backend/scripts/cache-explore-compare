#!/bin/bash
# cache-explore compare - Compare cache behavior across multiple configurations
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
BACKEND_DIR="$(dirname "$SCRIPT_DIR")"
PROJECT_ROOT="$(dirname "$BACKEND_DIR")"

select_latest_existing() {
  local selected=""

  for candidate in "$@"; do
    if [[ -f "$candidate" ]]; then
      if [[ -z "$selected" || "$candidate" -nt "$selected" ]]; then
        selected="$candidate"
      fi
    fi
  done

  if [[ -n "$selected" ]]; then
    echo "$selected"
  else
    echo "$1"
  fi
}

PASS="${CACHE_EXPLORER_PASS:-$(select_latest_existing \
  "$PROJECT_ROOT/build/backend/llvm-pass/CacheProfiler.so" \
  "$BACKEND_DIR/llvm-pass/build/CacheProfiler.so")}"
RUNTIME="${CACHE_EXPLORER_RUNTIME:-$(select_latest_existing \
  "$PROJECT_ROOT/build/backend/runtime/libcache-explorer-rt.a" \
  "$BACKEND_DIR/runtime/build/libcache-explorer-rt.a")}"
RUNTIME_INC="$BACKEND_DIR/runtime"
CACHE_SIM="${CACHE_EXPLORER_SIM:-$(select_latest_existing \
  "$PROJECT_ROOT/build/backend/cache-simulator/cache-sim" \
  "$BACKEND_DIR/cache-simulator/build/cache-sim")}"

usage() {
  echo "Usage: cache-explore compare [options] <source.c|.cpp>"
  echo ""
  echo "Compare cache behavior across multiple hardware configurations."
  echo "The source is compiled and traced once, then replayed across profiles."
  echo ""
  echo "Options:"
  echo "  --configs <list>   Comma-separated list of configs to compare"
  echo "                     (default: intel,amd,apple,educational)"
  echo "  --json             Output JSON format"
  echo "  -O<level>          Optimization level (default: -O0)"
  echo "  -D <name>=<val>    Preprocessor define"
  echo "  --sample <N>       Sample 1 in N events"
  echo "  --limit <N>        Max events to process"
  echo "  --prefetch <p>     Prefetch policy: none|next|stream|stride|adaptive|intel"
  echo "  --prefetch-degree <N> Number of lines to prefetch ahead"
  echo "  --fast             Disable 3C miss classification for faster simulation"
  echo "  --cache-segments   Cache repeated loop segments during simulation"
  echo "  --compiler <path>  Path to LLVM bin directory"
  echo "  -I <path>          Add include path"
  echo "  --help             Show this help"
  echo ""
  echo "Available configs:"
  echo "  Intel:   intel, intel14, xeon"
  echo "  AMD:     amd (zen4), zen3, epyc"
  echo "  Apple:   apple (m1), m2, m3"
  echo "  ARM:     graviton, rpi4, embedded"
  echo "  Other:   educational"
  echo ""
  echo "Examples:"
  echo "  cache-explore compare matrix.c"
  echo "  cache-explore compare matrix.c --configs intel,amd,apple"
  echo "  cache-explore compare matrix.c --configs intel,xeon,epyc --json"
}

CONFIGS="intel,amd,apple,educational"
JSON_OUTPUT=""
OPT_LEVEL="-O0"
DEFINES=()
INCLUDES=()
SAMPLE_RATE=""
EVENT_LIMIT=""
PREFETCH=""
PREFETCH_DEGREE=""
FAST_MODE=""
CACHE_SEGMENTS=""
COMPILER_PATH=""
INPUT_FILE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --configs) CONFIGS="$2"; shift 2 ;;
    --json) JSON_OUTPUT="1"; shift ;;
    --sample) SAMPLE_RATE="$2"; shift 2 ;;
    --limit) EVENT_LIMIT="$2"; shift 2 ;;
    --prefetch) PREFETCH="$2"; shift 2 ;;
    --prefetch-degree) PREFETCH_DEGREE="$2"; shift 2 ;;
    --fast) FAST_MODE="--fast"; shift ;;
    --cache-segments) CACHE_SEGMENTS="--cache-segments"; shift ;;
    --compiler) COMPILER_PATH="$2"; shift 2 ;;
    -O*) OPT_LEVEL="$1"; shift ;;
    -D) DEFINES+=("-D$2"); shift 2 ;;
    -D*) DEFINES+=("$1"); shift ;;
    -I) INCLUDES+=("-I$2"); shift 2 ;;
    -I*) INCLUDES+=("$1"); shift ;;
    --help) usage; exit 0 ;;
    -*) echo "Unknown option: $1"; usage; exit 1 ;;
    *) INPUT_FILE="$1"; shift ;;
  esac
done

if [[ -z "$INPUT_FILE" ]]; then
  echo "Error: No input file specified"
  usage
  exit 1
fi

if [[ ! -f "$INPUT_FILE" ]]; then
  echo "Error: File not found: $INPUT_FILE"
  exit 1
fi

# Detect compiler
EXT="${INPUT_FILE##*.}"
case "$EXT" in
  c) COMPILER="clang"; LANG="c"; BASENAME=$(basename "$INPUT_FILE" .c) ;;
  cpp|cc|cxx|C) COMPILER="clang++"; LANG="c++"; BASENAME=$(basename "$INPUT_FILE" ."$EXT") ;;
  *) echo "Error: Unsupported extension: .$EXT"; exit 1 ;;
esac

if [[ -n "$COMPILER_PATH" ]]; then
  if [[ "$EXT" == "c" && -x "$COMPILER_PATH/clang" ]]; then
    COMPILER="$COMPILER_PATH/clang"
  elif [[ "$EXT" != "c" && -x "$COMPILER_PATH/clang++" ]]; then
    COMPILER="$COMPILER_PATH/clang++"
  else
    echo "Error: compiler not found in: $COMPILER_PATH" >&2
    exit 1
  fi
fi

BINARY="/tmp/cache-explore-compare-$$-$BASENAME"
RESULT_DIR=""

enrich_json_output() {
  local defines_list=""
  local includes_list=""

  if [[ ${#DEFINES[@]} -gt 0 ]]; then
    defines_list="$(printf '%s\n' "${DEFINES[@]}")"
  fi
  if [[ ${#INCLUDES[@]} -gt 0 ]]; then
    includes_list="$(printf '%s\n' "${INCLUDES[@]}")"
  fi

  CACHE_EXPLORER_RESULT_KIND="hardware-comparison" \
  CACHE_EXPLORER_EXECUTOR="cli" \
  CACHE_EXPLORER_SOURCE="$INPUT_FILE" \
  CACHE_EXPLORER_LANGUAGE="$LANG" \
  CACHE_EXPLORER_CONFIGS="$CONFIGS" \
  CACHE_EXPLORER_OPT_LEVEL="$OPT_LEVEL" \
  CACHE_EXPLORER_DEFINES="$defines_list" \
  CACHE_EXPLORER_INCLUDES="$includes_list" \
  CACHE_EXPLORER_SAMPLE_RATE="${SAMPLE_RATE:-1}" \
  CACHE_EXPLORER_EVENT_LIMIT="${EVENT_LIMIT:-0}" \
  CACHE_EXPLORER_PREFETCH="${PREFETCH:-none}" \
  CACHE_EXPLORER_PREFETCH_DEGREE="${PREFETCH_DEGREE:-0}" \
  CACHE_EXPLORER_FAST_MODE="$FAST_MODE" \
  CACHE_EXPLORER_CACHE_SEGMENTS="$CACHE_SEGMENTS" \
  CACHE_EXPLORER_COMPILER="$COMPILER" \
  CACHE_EXPLORER_PASS="$PASS" \
  CACHE_EXPLORER_RUNTIME="$RUNTIME" \
  CACHE_EXPLORER_SIM="$CACHE_SIM" \
  CACHE_EXPLORER_CLI="$SCRIPT_DIR/cache-explore-compare" \
  CACHE_EXPLORER_PROJECT_ROOT="$PROJECT_ROOT" \
  "$SCRIPT_DIR/cache-explore-enrich-json"
}

cleanup() {
  rm -f "$BINARY"
  rm -f /tmp/cache-explore-compare-err-$$
  if [[ -n "$RESULT_DIR" ]]; then
    rm -rf "$RESULT_DIR"
  fi
}
trap cleanup EXIT

# Compile once
EXTRA_FLAGS=""
if [[ "$OPT_LEVEL" == "-O0" ]]; then
  EXTRA_FLAGS="-Xclang -disable-O0-optnone"
fi

if [[ -z "$JSON_OUTPUT" ]]; then
  echo "=== Cache Explorer Compare ===" >&2
  echo "Source: $INPUT_FILE" >&2
  echo "Configs: $CONFIGS" >&2
  echo "" >&2
  echo "Compiling..." >&2
fi

if ! $COMPILER $OPT_LEVEL $EXTRA_FLAGS -g -fpass-plugin="$PASS" \
  -I"$RUNTIME_INC" \
  "${INCLUDES[@]}" \
  "${DEFINES[@]}" \
  "$INPUT_FILE" \
  "$RUNTIME" \
  -o "$BINARY" 2>/tmp/cache-explore-compare-err-$$; then
  echo "Compilation failed:" >&2
  cat /tmp/cache-explore-compare-err-$$ >&2
  exit 1
fi

# Build runtime env
RUN_ENV=""
if [[ -n "$SAMPLE_RATE" ]]; then
  RUN_ENV="CACHE_EXPLORER_SAMPLE_RATE=$SAMPLE_RATE"
fi
if [[ -n "$EVENT_LIMIT" ]]; then
  RUN_ENV="$RUN_ENV CACHE_EXPLORER_MAX_EVENTS=$EVENT_LIMIT"
fi

# Run once to capture trace
if [[ -z "$JSON_OUTPUT" ]]; then
  echo "Running instrumented binary..." >&2
fi

if [[ -n "$RUN_ENV" ]]; then
  TRACE=$(env $RUN_ENV "$BINARY" 2>&1) || true
else
  TRACE=$("$BINARY" 2>&1) || true
fi

# Split configs
IFS=',' read -ra CONFIG_ARRAY <<< "$CONFIGS"

RESULT_DIR=$(mktemp -d /tmp/cache-explore-compare-results.XXXXXX)
RESULT_ARGS=()
SIM_COMMON_ARGS=(--json)

if [[ -n "$PREFETCH" ]]; then
  SIM_COMMON_ARGS+=(--prefetch "$PREFETCH")
fi
if [[ -n "$PREFETCH_DEGREE" ]]; then
  SIM_COMMON_ARGS+=(--prefetch-degree "$PREFETCH_DEGREE")
fi
if [[ -n "$FAST_MODE" ]]; then
  SIM_COMMON_ARGS+=(--fast)
fi
if [[ -n "$CACHE_SEGMENTS" ]]; then
  SIM_COMMON_ARGS+=(--cache-segments)
fi

for i in "${!CONFIG_ARRAY[@]}"; do
  cfg="${CONFIG_ARRAY[$i]}"
  result_path="$RESULT_DIR/result-$i.json"

  if ! echo "$TRACE" | "$CACHE_SIM" --config "$cfg" "${SIM_COMMON_ARGS[@]}" > "$result_path" 2>/dev/null; then
    printf '{"error":"failed to simulate config"}\n' > "$result_path"
  fi

  RESULT_ARGS+=("$cfg" "$result_path")
done

if [[ -n "$JSON_OUTPUT" ]]; then
  python3 - "$INPUT_FILE" "${RESULT_ARGS[@]}" <<'PY' | enrich_json_output
import json
import sys


def load_result(path):
    try:
        with open(path, "r", encoding="utf-8") as handle:
            return json.load(handle)
    except Exception as exc:
        return {"error": f"failed to parse simulator output: {exc}"}


def hit_rate(data, key):
    levels = data.get("levels", {})
    if key == "l1d":
        level = levels.get("l1d") or levels.get("l1") or {}
    else:
        level = levels.get(key) or {}
    value = level.get("hitRate")
    return value if isinstance(value, (int, float)) else None


def estimated_cycles(data, summary):
    value = summary.get("estimatedCycles")
    if isinstance(value, (int, float)) and value > 0:
        return value
    timing = data.get("timing") or {}
    value = timing.get("totalCycles")
    return value if isinstance(value, (int, float)) else 0


def summarize(config, data):
    profile = data.get("profile") or {}
    bottleneck = data.get("summary") or {}
    top_source = bottleneck.get("topSource")

    return {
        "config": config,
        "profile": {
            "id": profile.get("id", config),
            "displayName": profile.get("displayName", config),
            "vendor": profile.get("vendor"),
            "architecture": profile.get("architecture"),
            "class": profile.get("class"),
            "modelConfidence": profile.get("modelConfidence"),
        },
        "primaryBottleneck": bottleneck.get("primaryBottleneck", "unknown"),
        "estimatedCycles": estimated_cycles(data, bottleneck),
        "confidence": bottleneck.get("confidence", "unknown"),
        "bottleneckShare": bottleneck.get("bottleneckShare"),
        "topSource": top_source if isinstance(top_source, dict) else None,
        "hitRates": {
            "l1d": hit_rate(data, "l1d"),
            "l2": hit_rate(data, "l2"),
            "l3": hit_rate(data, "l3"),
        },
        "events": data.get("events", 0),
    }


source = sys.argv[1]
pairs = sys.argv[2:]
configs = {}
summary = []

for index in range(0, len(pairs), 2):
    config = pairs[index]
    path = pairs[index + 1]
    result = load_result(path)
    configs[config] = result
    summary.append(summarize(config, result))

print(json.dumps({"source": source, "summary": summary, "configs": configs}, indent=2))
PY
else
  # Human-readable output
  python3 - "${RESULT_ARGS[@]}" <<'PY'
import json
import sys


def load_result(path):
    try:
        with open(path, "r", encoding="utf-8") as handle:
            return json.load(handle)
    except Exception as exc:
        return {"error": str(exc)}


def hit_rate(data, key):
    levels = data.get("levels", {})
    if key == "l1d":
        level = levels.get("l1d") or levels.get("l1") or {}
    else:
        level = levels.get(key) or {}
    value = level.get("hitRate")
    return value if isinstance(value, (int, float)) else None


def percent(value):
    return "N/A" if value is None else f"{value * 100:.1f}%"


def integer(value):
    return "N/A" if not isinstance(value, int) else f"{value}"


def shorten(value, width):
    text = str(value) if value else "-"
    return text if len(text) <= width else text[: width - 3] + "..."


def top_source_text(summary):
    top_source = summary.get("topSource")
    if not isinstance(top_source, dict):
        return "-"
    file_name = top_source.get("file")
    line = top_source.get("line")
    if not file_name or not line:
        return "-"
    return f"{file_name}:{line}"


def estimated_cycles(data, summary):
    value = summary.get("estimatedCycles")
    if isinstance(value, (int, float)) and value > 0:
        return value
    timing = data.get("timing") or {}
    value = timing.get("totalCycles")
    return value if isinstance(value, (int, float)) else None


pairs = sys.argv[1:]
rows = []

for index in range(0, len(pairs), 2):
    config = pairs[index]
    data = load_result(pairs[index + 1])
    profile = data.get("profile") or {}
    summary = data.get("summary") or {}

    rows.append(
        {
            "config": config,
            "profile": profile.get("displayName", config),
            "bottleneck": summary.get("primaryBottleneck", "unknown"),
            "cycles": estimated_cycles(data, summary),
            "confidence": summary.get("confidence", "unknown"),
            "topSource": top_source_text(summary),
            "l1d": hit_rate(data, "l1d"),
            "l2": hit_rate(data, "l2"),
            "l3": hit_rate(data, "l3"),
            "events": data.get("events"),
        }
    )

print()
print("=== Hardware Summary ===")
print()
print(f"{'Config':<13} {'Profile':<24} {'Bottleneck':<11} {'Cycles':>12} {'Conf':<7}  Top Source")
print(f"{'-' * 13:<13} {'-' * 24:<24} {'-' * 11:<11} {'-' * 12:>12} {'-' * 7:<7}  {'-' * 40}")
for row in rows:
    print(
        f"{row['config']:<13} "
        f"{shorten(row['profile'], 24):<24} "
        f"{row['bottleneck']:<11} "
        f"{integer(row['cycles']):>12} "
        f"{row['confidence']:<7}  "
        f"{shorten(row['topSource'], 52)}"
    )

print()
print("=== Cache Hit Rates ===")
print()
print(f"{'Config':<13} {'L1D Hit':>9} {'L2 Hit':>9} {'L3 Hit':>9} {'Events':>10}")
print(f"{'-' * 13:<13} {'-' * 9:>9} {'-' * 9:>9} {'-' * 9:>9} {'-' * 10:>10}")
for row in rows:
    print(
        f"{row['config']:<13} "
        f"{percent(row['l1d']):>9} "
        f"{percent(row['l2']):>9} "
        f"{percent(row['l3']):>9} "
        f"{integer(row['events']):>10}"
    )
PY

  echo ""
  echo "Tip: Use --json for detailed results"
fi
