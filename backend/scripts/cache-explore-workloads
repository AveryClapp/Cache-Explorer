#!/usr/bin/env node

const { mkdir, readdir, readFile, stat, writeFile } = require('fs/promises')
const { spawnSync } = require('child_process')
const { createHash } = require('crypto')
const { dirname, join, resolve } = require('path')

function usage() {
  console.log(`Usage: cache-explore workloads [options] [workload-id]

List and verify benchmark workload snapshots modeled by Cache Explorer.

Options:
  --json       Output JSON
  --ids        Output only workload ids
  --commands   Print cache-explore commands for each variant
  --verify     Run variants and validate expected relationships
  --history <path>
               With --verify, write compact benchmark history JSON
  --history-summary <path>
               Summarize one benchmark history JSON file (repeat for multiple)
  --html       With --history-summary, output a standalone HTML trend report
  --help       Show this help

Examples:
  cache-explore workloads
  cache-explore workloads --ids
  cache-explore workloads conv2d-intel14 --json
  cache-explore workloads conv2d-intel14 --commands
  cache-explore workloads conv2d-intel14 --verify
  cache-explore workloads --verify --json
  cache-explore workloads --verify --history reports/workloads/history.json
  cache-explore workloads --history-summary reports/workloads/history.json
  cache-explore workloads --history-summary reports/workloads/*.json --json
  cache-explore workloads --history-summary reports/workloads/*.json --html > report.html`)
}

function projectRoot() {
  const scriptDir = dirname(resolve(process.argv[1]))
  return dirname(dirname(scriptDir))
}

function sha256(value) {
  return createHash('sha256').update(value).digest('hex')
}

function shortDigest(value) {
  return value ? value.slice(0, 12) : '-'
}

async function fileIdentity(path, displayPath = path) {
  const resolved = resolve(path)
  try {
    const [info, contents] = await Promise.all([
      stat(resolved),
      readFile(resolved),
    ])
    return {
      path: displayPath,
      exists: true,
      sizeBytes: info.size,
      mtimeMs: Math.trunc(info.mtimeMs),
      sha256: sha256(contents),
    }
  } catch (error) {
    return {
      path: displayPath,
      exists: false,
      error: error.code || error.message,
    }
  }
}

async function workloadIdentity(workload, file, rawManifest) {
  const root = projectRoot()
  const sourcePaths = [...new Set([
    workload.example,
    ...(workload.variants || []).map(variant => variant.example || workload.example),
  ].filter(Boolean))]
  const sourceFiles = Object.fromEntries(await Promise.all(sourcePaths.map(async sourcePath => [
    sourcePath,
    await fileIdentity(join(root, sourcePath), sourcePath),
  ])))

  return {
    manifestPath: file.replace(`${root}/`, ''),
    manifestSha256: sha256(rawManifest),
    sourceFiles,
  }
}

async function loadWorkloads() {
  const catalogDir = join(projectRoot(), 'benchmarks', 'workloads')
  const entries = await readdir(catalogDir, { withFileTypes: true })
  const files = entries
    .filter(entry => entry.isFile() && entry.name.endsWith('.json'))
    .map(entry => join(catalogDir, entry.name))
    .sort()

  const workloads = []
  for (const file of files) {
    const rawManifest = await readFile(file, 'utf8')
    const workload = JSON.parse(rawManifest)
    workload.identity = await workloadIdentity(workload, file, rawManifest)
    workloads.push(workload)
  }
  return workloads
}

function relationshipSummary(workload) {
  return (workload.expectedRelationships || [])
    .map(item => item.relationship)
    .join(', ')
}

function variantSummary(workload) {
  return (workload.variants || [])
    .map(variant => {
      const source = variant.example && variant.example !== workload.example
        ? `:${variant.example.split('/').pop()}`
        : ''
      return `${variant.id}${source}`
    })
    .join(', ')
}

function shellQuote(value) {
  const text = String(value)
  if (/^[A-Za-z0-9_./:=,@+-]+$/.test(text)) return text
  return `'${text.replace(/'/g, `'\\''`)}'`
}

function commandForVariant(workload, variant) {
  const args = ['cache-explore', variant.example || workload.example]
  const optLevel = variant.optLevel || workload.optLevel
  if (optLevel) args.push(optLevel)

  for (const define of variant.defines || []) {
    args.push('-D', define)
  }

  const prefetch = variant.prefetch || workload.prefetch
  if (prefetch) args.push('--prefetch', prefetch)

  args.push('--config', variant.config || workload.config)
  const limit = variant.limit ?? workload.limit
  if (limit) args.push('--limit', String(limit))
  args.push('--json')

  return args.map(shellQuote).join(' ')
}

function argsForVariant(workload, variant) {
  const args = [join(projectRoot(), variant.example || workload.example)]
  const optLevel = variant.optLevel || workload.optLevel
  if (optLevel) args.push(optLevel)

  for (const define of variant.defines || []) {
    args.push('-D', define)
  }

  const prefetch = variant.prefetch || workload.prefetch
  if (prefetch) args.push('--prefetch', prefetch)

  args.push('--config', variant.config || workload.config)
  const limit = variant.limit ?? workload.limit
  if (limit) args.push('--limit', String(limit))
  args.push('--json')

  return args
}

function printCommands(workloads) {
  for (const workload of workloads) {
    console.log(`# ${workload.id}: ${workload.description}`)
    for (const variant of workload.variants || []) {
      console.log(`# variant: ${variant.id}`)
      console.log(commandForVariant(workload, variant))
    }
    console.log('')
  }
}

function metricValue(result, metric) {
  return metric.split('.').reduce((value, key) => {
    if (value === undefined || value === null) return undefined
    return value[key]
  }, result)
}

function parseRelationship(relationship) {
  const [leftVariant, operator, rightVariant] = relationship.split(/\s+/)
  if (!leftVariant || !operator || !rightVariant) {
    throw new Error(`Invalid relationship: ${relationship}`)
  }
  return { leftVariant, operator, rightVariant }
}

function compareValues(left, operator, right) {
  switch (operator) {
    case '>':
      return left > right
    case '<':
      return left < right
    case '>=':
      return left >= right
    case '<=':
      return left <= right
    case '==':
    case '=':
      return left === right
    default:
      throw new Error(`Unsupported relationship operator: ${operator}`)
  }
}

function runVariant(workload, variant) {
  const start = Date.now()
  const result = spawnSync(join(projectRoot(), 'backend', 'scripts', 'cache-explore'), argsForVariant(workload, variant), {
    cwd: projectRoot(),
    encoding: 'utf8',
    maxBuffer: 64 * 1024 * 1024,
  })
  const durationMs = Date.now() - start

  if (result.status !== 0) {
    return {
      id: variant.id,
      ok: false,
      durationMs,
      error: result.stderr.trim() || result.stdout.trim() || `cache-explore exited with ${result.status}`,
    }
  }

  try {
    return {
      id: variant.id,
      ok: true,
      durationMs,
      result: JSON.parse(result.stdout.trim()),
    }
  } catch (error) {
    return {
      id: variant.id,
      ok: false,
      durationMs,
      error: error instanceof Error ? error.message : String(error),
    }
  }
}

function evaluateRelationships(workload, variants) {
  return (workload.expectedRelationships || []).map(item => {
    const { leftVariant, operator, rightVariant } = parseRelationship(item.relationship)
    const left = variants[leftVariant]
    const right = variants[rightVariant]
    const missingValue = typeof item.missingValue === 'number' ? item.missingValue : undefined
    const leftRaw = left?.ok ? metricValue(left.result, item.metric) : undefined
    const rightRaw = right?.ok ? metricValue(right.result, item.metric) : undefined
    const leftValue = leftRaw ?? missingValue
    const rightValue = rightRaw ?? missingValue
    const numeric = typeof leftValue === 'number' && typeof rightValue === 'number'
    const passed = numeric ? compareValues(leftValue, operator, rightValue) : false

    return {
      metric: item.metric,
      relationship: item.relationship,
      leftVariant,
      rightVariant,
      operator,
      leftValue,
      rightValue,
      passed,
      missingValue,
      error: numeric ? undefined : 'relationship values must be numeric',
    }
  })
}

function summarizeResult(result) {
  const summary = result.summary || {}
  const levels = result.levels || {}
  return {
    events: result.events,
    estimatedCycles: summary.estimatedCycles ?? result.timing?.totalCycles,
    primaryBottleneck: summary.primaryBottleneck,
    hitRates: {
      l1d: levels.l1d?.hitRate ?? levels.l1?.hitRate,
      l2: levels.l2?.hitRate,
      l3: levels.l3?.hitRate,
    },
  }
}

function verifyWorkload(workload) {
  const start = Date.now()
  const variantRuns = {}

  for (const variant of workload.variants || []) {
    variantRuns[variant.id] = runVariant(workload, variant)
  }

  const checks = evaluateRelationships(workload, variantRuns)
  const variants = Object.fromEntries(Object.entries(variantRuns).map(([id, run]) => [
    id,
    {
      ok: run.ok,
      durationMs: run.durationMs,
      error: run.error,
      summary: run.ok ? summarizeResult(run.result) : undefined,
      provenance: run.ok ? run.result.provenance : undefined,
    },
  ]))
  const failedVariantCount = Object.values(variantRuns).filter(run => !run.ok).length
  const failedCheckCount = checks.filter(check => !check.passed).length

  return {
    id: workload.id,
    description: workload.description,
    identity: workload.identity,
    ok: failedVariantCount === 0 && failedCheckCount === 0,
    durationMs: Date.now() - start,
    variants,
    checks,
  }
}

function verificationSummary(results) {
  const passed = results.reduce((count, result) => (
    count + result.checks.filter(check => check.passed).length
  ), 0)
  const failed = results.reduce((count, result) => (
    count + result.checks.filter(check => !check.passed).length
      + Object.values(result.variants).filter(variant => !variant.ok).length
  ), 0)

  return {
    ok: failed === 0,
    workloads: results.length,
    passed,
    failed,
    durationMs: results.reduce((total, result) => total + result.durationMs, 0),
  }
}

function historyRecord(summary, results) {
  return {
    schemaVersion: 1,
    generatedAt: new Date().toISOString(),
    git: {
      sha: process.env.GITHUB_SHA || process.env.CI_COMMIT_SHA || null,
      ref: process.env.GITHUB_REF_NAME || process.env.GITHUB_REF || process.env.CI_COMMIT_REF_NAME || null,
      runId: process.env.GITHUB_RUN_ID || process.env.CI_PIPELINE_ID || null,
    },
    summary,
    workloads: results.map(result => ({
      id: result.id,
      identity: result.identity,
      ok: result.ok,
      durationMs: result.durationMs,
      checks: result.checks.map(check => ({
        metric: check.metric,
        relationship: check.relationship,
        passed: check.passed,
        leftVariant: check.leftVariant,
        rightVariant: check.rightVariant,
        leftValue: check.leftValue,
        rightValue: check.rightValue,
      })),
      variants: Object.fromEntries(Object.entries(result.variants).map(([id, variant]) => [
        id,
        {
          ok: variant.ok,
          durationMs: variant.durationMs,
          events: variant.summary?.events,
          estimatedCycles: variant.summary?.estimatedCycles,
          primaryBottleneck: variant.summary?.primaryBottleneck,
          hitRates: variant.summary?.hitRates,
          fidelity: variant.provenance?.fidelity,
          hardwareProfile: variant.provenance?.hardwareProfile,
        },
      ])),
    })),
  }
}

async function writeHistory(path, summary, results) {
  await mkdir(dirname(resolve(path)), { recursive: true })
  await writeFile(resolve(path), `${JSON.stringify(historyRecord(summary, results), null, 2)}\n`)
}

async function expandHistoryPath(path) {
  const resolved = resolve(path)
  const info = await stat(resolved)
  if (!info.isDirectory()) return [resolved]

  const entries = await readdir(resolved, { withFileTypes: true })
  return entries
    .filter(entry => entry.isFile() && entry.name.endsWith('.json'))
    .map(entry => join(resolved, entry.name))
    .sort()
}

async function loadHistoryRecords(paths) {
  const files = []
  for (const path of paths) {
    files.push(...await expandHistoryPath(path))
  }

  const records = []
  for (const file of [...new Set(files)]) {
    const record = JSON.parse(await readFile(file, 'utf8'))
    records.push({ file, record })
  }

  records.sort((a, b) => String(a.record.generatedAt || '').localeCompare(String(b.record.generatedAt || '')))
  return records
}

function workloadDurationMap(record) {
  return new Map((record.workloads || []).map(workload => [workload.id, workload.durationMs || 0]))
}

function summarizeHistoryRecords(records) {
  const latestEntry = records[records.length - 1]
  const previousEntry = records.length > 1 ? records[records.length - 2] : null
  const latest = latestEntry?.record || {}
  const previousDurations = previousEntry ? workloadDurationMap(previousEntry.record) : new Map()

  const workloads = [...(latest.workloads || [])]
  const failures = workloads.flatMap(workload => (
    (workload.checks || [])
      .filter(check => !check.passed)
      .map(check => ({
        workload: workload.id,
        metric: check.metric,
        relationship: check.relationship,
        leftValue: check.leftValue,
        rightValue: check.rightValue,
      }))
  ))
  const slowestWorkloads = workloads
    .map(workload => ({
      id: workload.id,
      ok: workload.ok,
      durationMs: workload.durationMs || 0,
      checks: (workload.checks || []).length,
      variants: Object.keys(workload.variants || {}).length,
    }))
    .sort((a, b) => b.durationMs - a.durationMs)
    .slice(0, 5)
  const durationDeltas = workloads
    .map(workload => {
      const previousDurationMs = previousDurations.get(workload.id)
      if (typeof previousDurationMs !== 'number') return null
      const durationMs = workload.durationMs || 0
      const deltaMs = durationMs - previousDurationMs
      const deltaPct = previousDurationMs > 0 ? deltaMs / previousDurationMs : null
      return {
        id: workload.id,
        durationMs,
        previousDurationMs,
        deltaMs,
        deltaPct,
      }
    })
    .filter(Boolean)
    .sort((a, b) => Math.abs(b.deltaMs) - Math.abs(a.deltaMs))
    .slice(0, 5)

  return {
    files: records.map(({ file, record }) => ({
      file,
      generatedAt: record.generatedAt,
      ok: record.summary?.ok,
      passed: record.summary?.passed,
      failed: record.summary?.failed,
      durationMs: record.summary?.durationMs,
      git: record.git,
    })),
    latest: latestEntry ? {
      file: latestEntry.file,
      generatedAt: latest.generatedAt,
      git: latest.git,
      summary: latest.summary,
    } : null,
    failures,
    slowestWorkloads,
    durationDeltas,
  }
}

function formatMs(ms) {
  return `${Number(ms || 0).toLocaleString()}ms`
}

function escapeHtml(value) {
  return String(value ?? '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;')
}

function formatIso(value) {
  if (!value) return 'unknown'
  const date = new Date(value)
  if (Number.isNaN(date.getTime())) return String(value)
  return date.toISOString().replace('T', ' ').replace(/\.\d{3}Z$/, 'Z')
}

function buildWorkloadTrendRows(records) {
  const workloadIds = [...new Set(records.flatMap(({ record }) => (
    (record.workloads || []).map(workload => workload.id)
  )))].sort()
  const latestRecords = records.slice(-5)

  return workloadIds.map(id => {
    const durations = latestRecords.map(({ record }) => {
      const workload = (record.workloads || []).find(item => item.id === id)
      return workload ? workload.durationMs || 0 : null
    })
    const latestDuration = [...durations].reverse().find(value => typeof value === 'number')
    return { id, durations, latestDuration }
  }).sort((a, b) => (b.latestDuration || 0) - (a.latestDuration || 0))
}

function percent(value) {
  if (typeof value !== 'number') return ''
  const sign = value > 0 ? '+' : ''
  return `${sign}${(value * 100).toFixed(1)}%`
}

function printHistoryHtmlReport(summary, records) {
  const latest = summary.latest
  const status = latest?.summary?.failed > 0 ? 'failing' : 'passing'
  const trendRows = buildWorkloadTrendRows(records)
  const maxDuration = Math.max(
    1,
    ...trendRows.flatMap(row => row.durations.filter(value => typeof value === 'number')),
    ...summary.files.map(file => file.durationMs || 0),
  )
  const runRows = summary.files.map(file => `
        <tr>
          <td>${escapeHtml(formatIso(file.generatedAt))}</td>
          <td><span class="status ${file.failed > 0 ? 'fail' : 'ok'}">${file.failed > 0 ? 'failed' : 'passed'}</span></td>
          <td>${Number(file.passed || 0).toLocaleString()}</td>
          <td>${Number(file.failed || 0).toLocaleString()}</td>
          <td>${formatMs(file.durationMs)}</td>
          <td>${escapeHtml([file.git?.ref, file.git?.sha, file.git?.runId].filter(Boolean).join(' ') || '-')}</td>
        </tr>`).join('')
  const slowRows = summary.slowestWorkloads.map(workload => `
        <tr>
          <td>${escapeHtml(workload.id)}</td>
          <td>${formatMs(workload.durationMs)}</td>
          <td>${workload.variants}</td>
          <td>${workload.checks}</td>
          <td><span class="status ${workload.ok ? 'ok' : 'fail'}">${workload.ok ? 'passed' : 'failed'}</span></td>
        </tr>`).join('')
  const deltaRows = summary.durationDeltas.map(delta => `
        <tr>
          <td>${escapeHtml(delta.id)}</td>
          <td>${formatMs(delta.previousDurationMs)}</td>
          <td>${formatMs(delta.durationMs)}</td>
          <td class="${delta.deltaMs > 0 ? 'warn' : delta.deltaMs < 0 ? 'good' : ''}">${delta.deltaMs > 0 ? '+' : ''}${formatMs(delta.deltaMs)}</td>
          <td class="${delta.deltaMs > 0 ? 'warn' : delta.deltaMs < 0 ? 'good' : ''}">${percent(delta.deltaPct)}</td>
        </tr>`).join('')
  const failureRows = summary.failures.map(failure => `
        <tr>
          <td>${escapeHtml(failure.workload)}</td>
          <td>${escapeHtml(failure.metric)}</td>
          <td>${escapeHtml(failure.relationship)}</td>
          <td>${escapeHtml(`${failure.leftValue} vs ${failure.rightValue}`)}</td>
        </tr>`).join('')
  const trendHeader = records.slice(-5).map(({ record }) => (
    `<th>${escapeHtml(formatIso(record.generatedAt).split(' ')[0])}</th>`
  )).join('')
  const trendBody = trendRows.map(row => `
        <tr>
          <td>${escapeHtml(row.id)}</td>
          ${row.durations.map(value => {
            if (typeof value !== 'number') return '<td class="empty">-</td>'
            const width = Math.max(2, Math.round((value / maxDuration) * 100))
            return `<td><span class="bar" style="--w:${width}%"></span><span>${formatMs(value)}</span></td>`
          }).join('')}
        </tr>`).join('')

  console.log(`<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Cache Explorer Workload History</title>
  <style>
    :root { color-scheme: dark; --bg:#161616; --panel:#202020; --line:#363636; --text:#f0f0f0; --muted:#9ca3af; --ok:#5eead4; --fail:#fb7185; --warn:#fbbf24; --accent:#7dd3fc; }
    body { margin:0; background:var(--bg); color:var(--text); font:14px/1.5 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }
    main { max-width:1180px; margin:0 auto; padding:32px 20px 48px; }
    h1, h2 { margin:0; font-family:Inter, ui-sans-serif, system-ui, sans-serif; letter-spacing:0; }
    h1 { font-size:28px; }
    h2 { margin-top:28px; font-size:16px; }
    .lede { color:var(--muted); margin:8px 0 24px; }
    .cards { display:grid; grid-template-columns:repeat(auto-fit, minmax(170px, 1fr)); gap:12px; }
    .card, section { background:var(--panel); border:1px solid var(--line); border-radius:8px; padding:14px; }
    .label { color:var(--muted); font-size:11px; text-transform:uppercase; letter-spacing:0; }
    .value { display:block; margin-top:6px; font-size:20px; color:var(--text); }
    .status { display:inline-flex; padding:2px 8px; border:1px solid var(--line); border-radius:999px; font-size:12px; }
    .passing { color:var(--ok); }
    .status.ok { color:var(--ok); border-color:var(--ok); }
    .status.fail, .failing { color:var(--fail); border-color:var(--fail); }
    table { width:100%; border-collapse:collapse; margin-top:12px; }
    th, td { padding:9px 8px; border-bottom:1px solid var(--line); text-align:left; vertical-align:middle; }
    th { color:var(--muted); font-size:11px; text-transform:uppercase; letter-spacing:0; }
    td { overflow-wrap:anywhere; }
    .good { color:var(--ok); }
    .warn { color:var(--warn); }
    .empty { color:var(--muted); }
    .bar { display:inline-block; width:var(--w); min-width:2px; height:8px; margin-right:8px; border-radius:999px; background:var(--accent); vertical-align:middle; }
    @media (max-width: 760px) { main { padding:20px 12px 36px; } table { display:block; overflow-x:auto; } }
  </style>
</head>
<body>
  <main>
    <h1>Cache Explorer Workload History</h1>
    <p class="lede">Generated from benchmark-history artifacts. Use this report to spot failing workload contracts and runtime drift.</p>
    <div class="cards">
      <div class="card"><span class="label">Status</span><span class="value ${status}">${status}</span></div>
      <div class="card"><span class="label">History Files</span><span class="value">${summary.files.length}</span></div>
      <div class="card"><span class="label">Latest Checks</span><span class="value">${latest?.summary?.passed || 0} / ${latest?.summary?.failed || 0}</span></div>
      <div class="card"><span class="label">Latest Duration</span><span class="value">${formatMs(latest?.summary?.durationMs)}</span></div>
    </div>
    <section>
      <h2>Run History</h2>
      <table><thead><tr><th>Generated</th><th>Status</th><th>Passed</th><th>Failed</th><th>Duration</th><th>Git</th></tr></thead><tbody>${runRows || '<tr><td colspan="6">No history records.</td></tr>'}</tbody></table>
    </section>
    <section>
      <h2>Slowest Workloads</h2>
      <table><thead><tr><th>Workload</th><th>Duration</th><th>Variants</th><th>Checks</th><th>Status</th></tr></thead><tbody>${slowRows || '<tr><td colspan="5">No workloads.</td></tr>'}</tbody></table>
    </section>
    <section>
      <h2>Largest Duration Changes</h2>
      <table><thead><tr><th>Workload</th><th>Previous</th><th>Latest</th><th>Delta</th><th>Percent</th></tr></thead><tbody>${deltaRows || '<tr><td colspan="5">Need at least two history records.</td></tr>'}</tbody></table>
    </section>
    <section>
      <h2>Per-Workload Trend</h2>
      <table><thead><tr><th>Workload</th>${trendHeader}</tr></thead><tbody>${trendBody || '<tr><td>No workload trend data.</td></tr>'}</tbody></table>
    </section>
    <section>
      <h2>Failures</h2>
      <table><thead><tr><th>Workload</th><th>Metric</th><th>Relationship</th><th>Observed</th></tr></thead><tbody>${failureRows || '<tr><td colspan="4">No failing checks in latest history.</td></tr>'}</tbody></table>
    </section>
  </main>
</body>
</html>`)
}

function printHistorySummary(summary) {
  if (!summary.latest) {
    console.log('No workload history records found.')
    return
  }

  const latest = summary.latest
  console.log(`History files: ${summary.files.length}`)
  console.log(`Latest: ${latest.generatedAt || 'unknown'} (${latest.file})`)
  console.log(`Summary: ${latest.summary?.passed || 0} passed, ${latest.summary?.failed || 0} failed, ${formatMs(latest.summary?.durationMs)}`)
  if (latest.git?.sha || latest.git?.ref || latest.git?.runId) {
    console.log(`Git: ${[latest.git.ref, latest.git.sha, latest.git.runId].filter(Boolean).join(' ')}`)
  }

  if (summary.failures.length > 0) {
    console.log('\nFailures:')
    for (const failure of summary.failures) {
      console.log(`  ${failure.workload}: ${failure.metric} ${failure.relationship} (${failure.leftValue} vs ${failure.rightValue})`)
    }
  } else {
    console.log('\nFailures: none')
  }

  if (summary.slowestWorkloads.length > 0) {
    console.log('\nSlowest workloads:')
    for (const workload of summary.slowestWorkloads) {
      console.log(`  ${workload.id}: ${formatMs(workload.durationMs)} (${workload.variants} variants, ${workload.checks} checks)`)
    }
  }

  if (summary.durationDeltas.length > 0) {
    console.log('\nLargest duration changes:')
    for (const delta of summary.durationDeltas) {
      const sign = delta.deltaMs > 0 ? '+' : ''
      const pct = delta.deltaPct === null ? '' : `, ${sign}${(delta.deltaPct * 100).toFixed(1)}%`
      console.log(`  ${delta.id}: ${formatMs(delta.durationMs)} (${sign}${formatMs(delta.deltaMs)}${pct})`)
    }
  }
}

function printVerification(results) {
  const summary = verificationSummary(results)

  for (const result of results) {
    console.log(`Snapshot: ${result.id}`)
    console.log(`  ${result.description}`)
    for (const [variantId, variant] of Object.entries(result.variants)) {
      const status = variant.ok ? 'PASS' : 'FAIL'
      console.log(`  Variant: ${variantId} ${status} (${variant.durationMs}ms)`)
      if (variant.error) console.log(`    ${variant.error}`)
    }
    for (const check of result.checks) {
      const status = check.passed ? 'PASS' : 'FAIL'
      console.log(`  Check: ${check.metric} ${check.relationship} ${status} (${check.leftValue} vs ${check.rightValue})`)
      if (check.error) console.log(`    ${check.error}`)
    }
    console.log('')
  }

  console.log(`Summary: ${summary.passed} passed, ${summary.failed} failed, ${summary.durationMs}ms`)
  if (!summary.ok) process.exitCode = 1
}

function printTable(workloads) {
  const headers = ['ID', 'Digest', 'Example', 'Config', 'Limit', 'Variants', 'Relationships']
  const rows = workloads.map(workload => [
    workload.id,
    shortDigest(workload.identity?.manifestSha256),
    workload.example,
    workload.config,
    String(workload.limit || 'full'),
    variantSummary(workload),
    relationshipSummary(workload),
  ])
  const widths = headers.map((header, index) => (
    Math.max(header.length, ...rows.map(row => row[index].length))
  ))
  const formatRow = row => row.map((cell, index) => cell.padEnd(widths[index])).join('  ')

  console.log(formatRow(headers))
  console.log(formatRow(widths.map(width => '-'.repeat(width))))
  for (const row of rows) {
    console.log(formatRow(row))
  }
}

function parseArgs(args) {
  const parsed = {
    json: false,
    ids: false,
    commands: false,
    verify: false,
    html: false,
    help: false,
    historyPath: '',
    historySummaryPaths: [],
    workloadId: '',
  }

  for (let index = 0; index < args.length; index += 1) {
    const arg = args[index]
    if (arg === '--json') parsed.json = true
    else if (arg === '--ids') parsed.ids = true
    else if (arg === '--commands') parsed.commands = true
    else if (arg === '--verify') parsed.verify = true
    else if (arg === '--html') parsed.html = true
    else if (arg === '--help' || arg === '-h') parsed.help = true
    else if (arg === '--history') {
      if (!args[index + 1] || args[index + 1].startsWith('-')) {
        throw new Error('--history requires a path')
      }
      parsed.historyPath = args[index + 1]
      index += 1
    } else if (arg.startsWith('--history=')) {
      parsed.historyPath = arg.slice('--history='.length)
      if (!parsed.historyPath) {
        throw new Error('--history requires a path')
      }
    } else if (arg === '--history-summary') {
      let consumed = 0
      while (args[index + 1] && !args[index + 1].startsWith('-')) {
        parsed.historySummaryPaths.push(args[index + 1])
        index += 1
        consumed += 1
      }
      if (consumed === 0) {
        throw new Error('--history-summary requires a path')
      }
    } else if (arg.startsWith('--history-summary=')) {
      const historySummaryPath = arg.slice('--history-summary='.length)
      if (!historySummaryPath) {
        throw new Error('--history-summary requires a path')
      }
      parsed.historySummaryPaths.push(historySummaryPath)
    } else if (arg.startsWith('-')) {
      throw new Error(`Unknown option: ${arg}`)
    } else if (!parsed.workloadId) {
      parsed.workloadId = arg
    } else {
      throw new Error(`Unexpected argument: ${arg}`)
    }
  }

  return parsed
}

async function main() {
  const { json, ids, commands, verify, html, help, historyPath, historySummaryPaths, workloadId } = parseArgs(process.argv.slice(2))

  if (help) {
    usage()
    return
  }

  if (historyPath && !verify) {
    console.error('--history requires --verify')
    process.exitCode = 1
    return
  }
  if (html && json) {
    console.error('--html cannot be combined with --json')
    process.exitCode = 1
    return
  }
  if (html && historySummaryPaths.length === 0) {
    console.error('--html requires --history-summary')
    process.exitCode = 1
    return
  }
  if (historySummaryPaths.length > 0) {
    const records = await loadHistoryRecords(historySummaryPaths)
    const summary = summarizeHistoryRecords(records)
    if (html) {
      printHistoryHtmlReport(summary, records)
    } else if (json) {
      console.log(JSON.stringify(summary, null, 2))
    } else {
      printHistorySummary(summary)
    }
    return
  }
  const workloads = await loadWorkloads()
  const selected = workloadId
    ? workloads.filter(workload => workload.id === workloadId)
    : workloads

  if (workloadId && selected.length === 0) {
    console.error(`Unknown workload snapshot: ${workloadId}`)
    process.exitCode = 1
    return
  }

  if (verify) {
    const results = selected.map(verifyWorkload)
    const summary = verificationSummary(results)
    if (historyPath) {
      await writeHistory(historyPath, summary, results)
    }
    if (json) {
      console.log(JSON.stringify({ ok: summary.ok, summary, workloads: results }, null, 2))
    } else {
      printVerification(results)
    }
    if (!summary.ok) process.exitCode = 1
  } else if (json) {
    console.log(JSON.stringify(workloadId ? selected[0] : { workloads: selected }, null, 2))
  } else if (ids) {
    console.log(selected.map(workload => workload.id).join('\n'))
  } else if (commands) {
    printCommands(selected)
  } else {
    printTable(selected)
  }
}

main().catch(error => {
  console.error(error instanceof Error ? error.message : String(error))
  process.exitCode = 1
})
