#!/bin/bash
# cache-explore doctor - Check local readiness without running user code.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
BACKEND_DIR="$(dirname "$SCRIPT_DIR")"
PROJECT_ROOT="$(dirname "$BACKEND_DIR")"

select_latest_existing() {
  local selected=""

  for candidate in "$@"; do
    if [[ -f "$candidate" ]]; then
      if [[ -z "$selected" || "$candidate" -nt "$selected" ]]; then
        selected="$candidate"
      fi
    fi
  done

  if [[ -n "$selected" ]]; then
    echo "$selected"
  else
    echo "$1"
  fi
}

PASS=$(select_latest_existing \
  "$PROJECT_ROOT/build/backend/llvm-pass/CacheProfiler.so" \
  "$BACKEND_DIR/llvm-pass/build/CacheProfiler.so")
RUNTIME=$(select_latest_existing \
  "$PROJECT_ROOT/build/backend/runtime/libcache-explorer-rt.a" \
  "$BACKEND_DIR/runtime/build/libcache-explorer-rt.a")
CACHE_SIM=$(select_latest_existing \
  "$PROJECT_ROOT/build/backend/cache-simulator/cache-sim" \
  "$BACKEND_DIR/cache-simulator/build/cache-sim")

FAILURES=0
WARNINGS=0

ok() {
  printf 'ok    %s\n' "$1"
}

warn() {
  WARNINGS=$((WARNINGS + 1))
  printf 'warn  %s\n' "$1"
}

fail() {
  FAILURES=$((FAILURES + 1))
  printf 'fail  %s\n' "$1"
}

has_cmd() {
  command -v "$1" >/dev/null 2>&1
}

check_file() {
  local label="$1"
  local path="$2"
  if [[ -f "$path" ]]; then
    ok "$label: $path"
  else
    fail "$label missing: $path"
  fi
}

compiler_cmd() {
  if [[ -n "${CACHE_EXPLORER_CC:-}" ]]; then
    printf '%s\n' "$CACHE_EXPLORER_CC"
    return
  fi

  if has_cmd clang && ! clang --version 2>/dev/null | head -1 | grep -qi apple; then
    command -v clang
    return
  fi

  for version in 21 20 19 18 17; do
    if has_cmd "clang-$version"; then
      command -v "clang-$version"
      return
    fi
  done

  if has_cmd llvm-config; then
    local llvm_clang
    llvm_clang="$(llvm-config --bindir 2>/dev/null)/clang"
    if [[ -x "$llvm_clang" ]]; then
      printf '%s\n' "$llvm_clang"
      return
    fi
  fi

  if has_cmd brew; then
    local formula prefix
    for formula in llvm llvm@21 llvm@20 llvm@19 llvm@18 llvm@17; do
      prefix="$(brew --prefix "$formula" 2>/dev/null || true)"
      if [[ -x "$prefix/bin/clang" ]]; then
        printf '%s\n' "$prefix/bin/clang"
        return
      fi
    done
  fi
}

echo "Hardware Explorer Preview Doctor"
echo "================================"
echo ""

CLANG_CMD="$(compiler_cmd)"
if [[ -z "$CLANG_CMD" ]]; then
  fail "LLVM clang not found"
else
  VERSION_OUTPUT="$("$CLANG_CMD" --version 2>/dev/null | head -1)"
  if echo "$VERSION_OUTPUT" | grep -qi "apple"; then
    fail "Apple clang detected; install upstream LLVM and set CACHE_EXPLORER_CC or use --compiler"
  else
    ok "compiler: $CLANG_CMD ($VERSION_OUTPUT)"
  fi
fi

check_file "LLVM pass" "$PASS"
check_file "runtime library" "$RUNTIME"
check_file "cache simulator" "$CACHE_SIM"

if [[ -n "$CLANG_CMD" && -f "$PASS" ]]; then
  if printf 'int cache_explorer_doctor_probe(void) { return 0; }\n' \
    | "$CLANG_CMD" -x c -fpass-plugin="$PASS" -c - -o /dev/null >/dev/null 2>&1; then
    ok "compiler can load LLVM pass"
  else
    fail "compiler cannot load LLVM pass; rebuild with ./scripts/build.sh using the selected upstream LLVM"
  fi
fi

if has_cmd node; then
  ok "node: $(node --version)"
else
  fail "node not found"
fi

if has_cmd npm; then
  ok "npm: $(npm --version)"
else
  warn "npm not found"
fi

if [[ -d "$BACKEND_DIR/server/node_modules" ]]; then
  ok "backend node_modules present"
else
  fail "backend dependencies missing; run npm install in backend/server"
fi

if [[ -d "$PROJECT_ROOT/frontend/node_modules" ]]; then
  ok "frontend node_modules present"
else
  warn "frontend dependencies missing; run npm install in frontend"
fi

if node --input-type=module - "$BACKEND_DIR/server" >/tmp/cache-explorer-doctor-db.$$ 2>&1 <<'NODE'
const serverDir = process.argv[2];
const db = await import(`${serverDir}/db.js`);
const metrics = await import(`${serverDir}/metrics.js`);
const health = metrics.getHealthStatus();
if (health.checks.database !== 'ok' || health.checks.temp_dir !== 'ok') {
  console.error(JSON.stringify(health, null, 2));
  process.exit(1);
}
NODE
then
  ok "server database and temp directory"
else
  fail "server database/temp health failed: $(tail -1 /tmp/cache-explorer-doctor-db.$$)"
fi
rm -f /tmp/cache-explorer-doctor-db.$$

if has_cmd docker; then
  if docker info >/dev/null 2>&1; then
    ok "docker available for sandbox mode"
  else
    warn "docker command exists, but daemon is not reachable"
  fi
else
  warn "docker not found; ENABLE_SANDBOX=1 will not work"
fi

echo ""
if [[ "$FAILURES" -gt 0 ]]; then
  echo "Doctor found $FAILURES failure(s) and $WARNINGS warning(s)."
  exit 1
fi

echo "Doctor passed with $WARNINGS warning(s)."
