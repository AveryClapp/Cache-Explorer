#!/bin/bash
set -e
set +m  # Disable job control to suppress initialization warnings in sandboxed environments

# Hardware Explorer is the product-facing name. Mirror its environment prefix
# into the established Cache Explorer variables so existing internals and user
# automation continue to work unchanged. The new name wins when both are set.
while IFS= read -r hardware_var; do
  legacy_var="CACHE_EXPLORER_${hardware_var#HARDWARE_EXPLORER_}"
  printf -v "$legacy_var" '%s' "${!hardware_var}"
  export "$legacy_var"
done < <(compgen -A variable HARDWARE_EXPLORER_)

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
BACKEND_DIR="$(dirname "$SCRIPT_DIR")"
PROJECT_ROOT="$(dirname "$BACKEND_DIR")"

# Support both build layouts:
# 1. Top-level build/ directory (cmake from project root)
# 2. Per-component build/ directories (legacy)
select_latest_existing() {
  local selected=""

  for candidate in "$@"; do
    if [[ -f "$candidate" ]]; then
      if [[ -z "$selected" || "$candidate" -nt "$selected" ]]; then
        selected="$candidate"
      fi
    fi
  done

  if [[ -n "$selected" ]]; then
    echo "$selected"
  else
    echo "$1"
  fi
}

PASS="${CACHE_EXPLORER_PASS:-$(select_latest_existing \
  "$PROJECT_ROOT/build/backend/llvm-pass/CacheProfiler.so" \
  "$BACKEND_DIR/llvm-pass/build/CacheProfiler.so")}"
RUNTIME="${CACHE_EXPLORER_RUNTIME:-$(select_latest_existing \
  "$PROJECT_ROOT/build/backend/runtime/libcache-explorer-rt.a" \
  "$BACKEND_DIR/runtime/build/libcache-explorer-rt.a")}"
CACHE_SIM="${CACHE_EXPLORER_SIM:-$(select_latest_existing \
  "$PROJECT_ROOT/build/backend/cache-simulator/cache-sim" \
  "$BACKEND_DIR/cache-simulator/build/cache-sim")}"
RUNTIME_INC="$BACKEND_DIR/runtime"
CMAKE_MODULE="$BACKEND_DIR/integration/cmake"

# Export for subcommands (don't override if already set externally, e.g. from a git worktree)
export CACHE_EXPLORER_PATH="${CACHE_EXPLORER_PATH:-$BACKEND_DIR}"
export CACHE_EXPLORER_PASS="$PASS"
export CACHE_EXPLORER_RUNTIME="$RUNTIME"
export CACHE_EXPLORER_SIM="$CACHE_SIM"

# Pass cache directory
PASS_CACHE_DIR="${CACHE_EXPLORER_CACHE_DIR:-$HOME/.cache/cache-explorer/passes}"

#######################################
# Detect platform (OS and architecture)
# Arguments:
#   None
# Outputs:
#   Platform string (e.g., darwin-arm64, linux-x64)
#######################################
detect_platform() {
  local os arch

  # Detect OS
  case "$(uname -s)" in
    Darwin)
      os="darwin"
      ;;
    Linux)
      os="linux"
      ;;
    *)
      os="unknown"
      ;;
  esac

  # Detect architecture
  case "$(uname -m)" in
    x86_64|amd64)
      arch="x64"
      ;;
    arm64|aarch64)
      arch="arm64"
      ;;
    *)
      arch="unknown"
      ;;
  esac

  echo "${os}-${arch}"
}

#######################################
# Get LLVM major version from a clang command
# Arguments:
#   clang_cmd - Path or command name for clang
# Outputs:
#   LLVM major version number (e.g., 17, 18, 19)
#   Returns 1 if version cannot be detected or is Apple clang
#######################################
get_llvm_version() {
  local clang_cmd="$1"

  # Parse version from clang --version output
  local version_output
  version_output=$("$clang_cmd" --version 2>/dev/null | head -1) || return 1

  # Apple clang uses different versioning - not compatible
  if echo "$version_output" | grep -qi "apple"; then
    return 1
  fi

  # Extract version number (major.minor.patch or major.minor)
  local version
  version=$(echo "$version_output" | grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' | head -1)

  if [[ -z "$version" ]]; then
    return 1
  fi

  # Extract major version
  echo "$version" | cut -d. -f1
}

command_exists() {
  local candidate="$1"
  if [[ "$candidate" == */* ]]; then
    [[ -x "$candidate" ]]
  else
    command -v "$candidate" >/dev/null 2>&1
  fi
}

is_upstream_clang() {
  local candidate="$1"
  command_exists "$candidate" || return 1
  ! "$candidate" --version 2>/dev/null | head -1 | grep -qi "apple"
}

find_upstream_clang() {
  local candidate=""

  if [[ -n "${COMPILER_PATH:-}" ]]; then
    candidate="$COMPILER_PATH/clang"
    is_upstream_clang "$candidate" && { echo "$candidate"; return 0; }
  fi

  if [[ -n "${CACHE_EXPLORER_CC:-}" ]]; then
    candidate="$CACHE_EXPLORER_CC"
    is_upstream_clang "$candidate" && { echo "$candidate"; return 0; }
  fi

  if is_upstream_clang clang; then
    command -v clang
    return 0
  fi

  for version in 21 20 19 18 17; do
    candidate="clang-$version"
    if is_upstream_clang "$candidate"; then
      command -v "$candidate"
      return 0
    fi
  done

  if command -v llvm-config >/dev/null 2>&1; then
    candidate="$(llvm-config --bindir 2>/dev/null)/clang"
    is_upstream_clang "$candidate" && { echo "$candidate"; return 0; }
  fi

  if command -v brew >/dev/null 2>&1; then
    local formula prefix
    for formula in llvm llvm@21 llvm@20 llvm@19 llvm@18 llvm@17; do
      prefix="$(brew --prefix "$formula" 2>/dev/null || true)"
      candidate="$prefix/bin/clang"
      is_upstream_clang "$candidate" && { echo "$candidate"; return 0; }
    done
  fi

  return 1
}

find_upstream_clangxx() {
  if [[ -n "${CACHE_EXPLORER_CXX:-}" ]] && command_exists "$CACHE_EXPLORER_CXX"; then
    echo "$CACHE_EXPLORER_CXX"
    return 0
  fi

  local clang_cmd clang_path clang_dir clang_name candidate
  clang_cmd="$(find_upstream_clang)" || return 1
  clang_path="$(command -v "$clang_cmd" 2>/dev/null || echo "$clang_cmd")"
  clang_dir="$(dirname "$clang_path")"
  clang_name="$(basename "$clang_path")"

  if [[ "$clang_name" == clang-* ]]; then
    candidate="$clang_dir/clang++-${clang_name#clang-}"
    if ! command_exists "$candidate"; then
      candidate="$clang_dir/clang++"
    fi
  else
    candidate="$clang_dir/clang++"
  fi

  command_exists "$candidate" || return 1
  echo "$candidate"
}

# Make the selected upstream toolchain available to every subcommand. Several
# subcommands dispatch before the single-file compiler's argument parsing.
if SELECTED_CC="$(find_upstream_clang 2>/dev/null)"; then
  export CACHE_EXPLORER_CC="$SELECTED_CC"
fi
if SELECTED_CXX="$(find_upstream_clangxx 2>/dev/null)"; then
  export CACHE_EXPLORER_CXX="$SELECTED_CXX"
fi

#######################################
# Resolve the LLVM pass to use
# Checks: local build -> cached pass -> download
# Globals:
#   PASS, COMPILER_PATH, PASS_CACHE_DIR, SCRIPT_DIR
# Arguments:
#   None
# Outputs:
#   Sets RESOLVED_PASS to the path of the pass to use
#   Returns 1 on failure
#######################################
resolve_pass() {
  # 1. Check if local development build exists
  if [[ -f "$PASS" ]]; then
    RESOLVED_PASS="$PASS"
    return 0
  fi

  # 2. Need to detect LLVM version and platform for cached/downloaded passes
  local clang_cmd=""
  if ! clang_cmd="$(find_upstream_clang)"; then
    echo "Error: upstream LLVM clang not found. Please install LLVM/clang." >&2
    return 1
  fi

  # Get LLVM version
  local llvm_version
  if ! llvm_version=$(get_llvm_version "$clang_cmd"); then
    # Check if it's Apple clang
    local version_output
    version_output=$("$clang_cmd" --version 2>/dev/null | head -1)
    if echo "$version_output" | grep -qi "apple"; then
      echo "Error: Apple clang detected. Hardware Explorer requires upstream LLVM." >&2
      echo "" >&2
      echo "To fix this, install LLVM via Homebrew:" >&2
      echo "  brew install llvm" >&2
      echo "" >&2
      echo "Then either:" >&2
      echo "  1. Use --compiler flag: cache-explore --compiler /opt/homebrew/opt/llvm/bin myfile.c" >&2
      echo "  2. Set environment: export CACHE_EXPLORER_CC=/opt/homebrew/opt/llvm/bin/clang" >&2
      return 1
    fi
    echo "Error: Could not detect LLVM version from: $clang_cmd" >&2
    return 1
  fi

  # Detect platform
  local platform
  platform=$(detect_platform)

  # Construct pass filename
  local pass_filename="CacheProfiler-llvm${llvm_version}-${platform}.so"

  # 3. Check cached pass directory
  local cached_pass="$PASS_CACHE_DIR/$pass_filename"
  if [[ -f "$cached_pass" && -x "$cached_pass" ]]; then
    RESOLVED_PASS="$cached_pass"
    return 0
  fi

  # Also check in latest/ subdirectory (where download-pass puts it)
  local cached_pass_latest="$PASS_CACHE_DIR/latest/$pass_filename"
  local download_script="$SCRIPT_DIR/cache-explore-download-pass"
  if [[ -f "$cached_pass_latest" && -x "$cached_pass_latest" ]]; then
    local verified_cached_pass
    if [[ -x "$download_script" ]] &&
       verified_cached_pass=$("$download_script" "$llvm_version" 2>&1 | tail -1) &&
       [[ -f "$verified_cached_pass" ]]; then
      RESOLVED_PASS="$verified_cached_pass"
      return 0
    fi
    echo "Cached downloaded pass failed verification: $cached_pass_latest" >&2
  fi

  # 4. Try to download the pass
  if [[ -x "$download_script" ]]; then
    echo "No local pass found. Attempting to download pre-built pass..." >&2
    local downloaded_pass
    if downloaded_pass=$("$download_script" "$llvm_version" 2>&1 | tail -1) && [[ -f "$downloaded_pass" ]]; then
      RESOLVED_PASS="$downloaded_pass"
      return 0
    fi
  fi

  # 5. All options failed - provide helpful error message
  echo "" >&2
  echo "Error: Could not find or download CacheProfiler pass for LLVM $llvm_version ($platform)" >&2
  echo "" >&2
  echo "Options to resolve this:" >&2
  echo "" >&2
  echo "  1. Build the pass locally (recommended):" >&2
  echo "     cache-explore build-pass" >&2
  echo "" >&2
  echo "  2. Build from source (for development):" >&2
  echo "     cd backend/llvm-pass && mkdir -p build && cd build" >&2
  echo "     cmake .. -G Ninja -DLLVM_DIR=/path/to/llvm/lib/cmake/llvm" >&2
  echo "     ninja" >&2
  echo "" >&2
  echo "  3. If using a different LLVM version, specify with --compiler:" >&2
  echo "     cache-explore --compiler /path/to/llvm/bin myfile.c" >&2
  echo "" >&2
  return 1
}

main_usage() {
  echo "Hardware Explorer Preview - CPU performance modeling for source code"
  echo ""
  echo "Usage: cache-explore <command> [options]"
  echo ""
  echo "Commands:"
  echo "  <source.c|cpp>    Compile and analyze a single source file"
  echo "  run <binary>      Analyze an already-instrumented binary"
  echo "  cmake <path>      Configure a CMake project with profiling"
  echo "  make <target>     Build and analyze a Makefile target"
  echo "  compare           Compare cache behavior across configs"
  echo "  experiment        Compare named source variants across configs"
  echo "  profiles          List modeled hardware profiles"
  echo "  workloads         List benchmark workload snapshots"
  echo "  calibration       Validate calibration evidence packets"
  echo "  report            Generate HTML report from analysis"
  echo "  cc/c++            Compiler wrapper for build system integration"
  echo "  build-pass        Build the LLVM pass locally for your clang version"
  echo "  cache             Manage cached passes (list, clear, size)"
  echo "  doctor            Check local toolchain, build artifacts, and server deps"
  echo "  pin <binary>      Profile a pre-compiled binary via Intel Pin"
  echo ""
  echo "Examples:"
  echo "  cache-explore matrix.c --config educational"
  echo "  cache-explore run ./my_program --json"
  echo "  cache-explore cmake /path/to/project -DCMAKE_BUILD_TYPE=Release"
  echo "  cache-explore compare matrix.c --configs intel,amd,apple"
  echo "  cache-explore experiment conv2d.c -O2 --variant direct --variant tiled:RUN_TILED=1"
  echo "  cache-explore profiles --ids"
  echo "  cache-explore workloads --ids"
  echo "  cache-explore calibration"
  echo "  cache-explore doctor"
  echo ""
  echo "Run 'cache-explore <command> --help' for command-specific help."
}

# Check if first arg is a subcommand
if [[ $# -eq 0 ]]; then
  main_usage
  exit 0
fi

case "$1" in
  run)
    shift
    exec "$SCRIPT_DIR/cache-explore-run" "$@"
    ;;
  cmake)
    shift
    exec "$SCRIPT_DIR/cache-explore-cmake" "$@"
    ;;
  make)
    shift
    exec "$SCRIPT_DIR/cache-explore-make" "$@"
    ;;
  compare)
    shift
    exec "$SCRIPT_DIR/cache-explore-compare" "$@"
    ;;
  experiment)
    shift
    exec "$SCRIPT_DIR/cache-explore-experiment" "$@"
    ;;
  profiles)
    shift
    exec "$SCRIPT_DIR/cache-explore-profiles" "$@"
    ;;
  workloads)
    shift
    exec "$SCRIPT_DIR/cache-explore-workloads" "$@"
    ;;
  calibration)
    shift
    exec "$SCRIPT_DIR/cache-explore-calibration" "$@"
    ;;
  report)
    shift
    exec "$SCRIPT_DIR/cache-explore-report" "$@"
    ;;
  cc)
    shift
    exec "$SCRIPT_DIR/cache-explore-cc" "$@"
    ;;
  c++)
    shift
    exec "$SCRIPT_DIR/cache-explore-cxx" "$@"
    ;;
  build-pass)
    shift
    exec "$SCRIPT_DIR/cache-explore-build-pass" "$@"
    ;;
  cache)
    shift
    exec "$SCRIPT_DIR/cache-explore-cache" "$@"
    ;;
  doctor)
    shift
    exec "$SCRIPT_DIR/cache-explore-doctor" "$@"
    ;;
  pin)
    shift
    exec "$SCRIPT_DIR/cache-explore-pin" "$@"
    ;;
  --help|-h)
    main_usage
    exit 0
    ;;
esac

# Default: compile and analyze a source file
CONFIG="intel"
VERBOSE=""
KEEP_BINARY=""
JSON_OUTPUT=""
STREAM_OUTPUT=""
INPUT_FILE=""
DEFINES=()  # Array of -D flags
INCLUDES=() # Array of -I flags
SAMPLE_RATE=""
EVENT_LIMIT=""
PREFETCH=""
PREFETCH_DEGREE=""
COMPILER_PATH=""  # Path to LLVM bin directory (e.g., /opt/homebrew/opt/llvm@20/bin)
MULTI_FILE=""  # Flag to enable multi-file compilation
FAST_MODE=""  # Flag to disable 3C miss classification for speed
CACHE_SEGMENTS=""  # Flag to enable segment caching for repeated loops
INSTRUMENT_ONLY=()  # Array of patterns to whitelist
EXCLUDE_PATTERNS=()  # Array of patterns to blacklist

usage() {
  echo "Usage: cache-explore [options] <source.c|.cpp|.rs>"
  echo ""
  echo "Compile, instrument, run, and analyze cache behavior."
  echo "Supports C, C++, and Rust source files."
  echo ""
  echo "Options:"
  echo "  --config <name>   Cache config: intel|intel14|xeon|amd|zen3|epyc|"
  echo "                    apple|m2|m3|graviton|rpi4|embedded|educational"
  echo "  --hardware <name> Alias for --config"
  echo "  --verbose         Show each cache event"
  echo "  --keep            Keep the instrumented binary"
  echo "  --json            Output JSON format"
  echo "  --stream          Stream events in real-time (for WebSocket)"
  echo "  --multi-file      Compile all .c/.cpp files in the same directory"
  echo "  --sample <N>      Sample 1 in N events (e.g., 100 = 1% sampling)"
  echo "  --limit <N>       Stop after N events (e.g., 1000000 = 1M events max)"
  echo "  --prefetch <type> Enable prefetching: none|next|stream|stride|adaptive|intel"
  echo "  --prefetch-degree <N>  How many lines to prefetch ahead (default: 4)"
  echo "  --compiler <path> Path to LLVM bin directory (e.g., /opt/homebrew/opt/llvm@20/bin)"
  echo "  --fast            Fast mode: ~3x speedup, skips 3C miss classification"
  echo "  --cache-segments  Cache repeated loop segments for speedup (experimental)"
  echo "  -O<level>         Optimization level (default: -O0)"
  echo "  -D <name>=<val>   Preprocessor define (can be used multiple times)"
  echo ""
  echo "Selective Instrumentation (for large codebases):"
  echo "  --instrument-only <pattern>  Only instrument functions/files matching pattern"
  echo "  --exclude <pattern>          Exclude functions/files matching pattern"
  echo ""
  echo "  --help            Show this help"
  echo ""
  echo "Examples:"
  echo "  cache-explore matrix.c --config educational --verbose"
  echo "  cache-explore vector.cpp -O2 --json"
  echo "  cache-explore matrix.c -D N=1000 -D DEBUG"
  echo "  cache-explore bigprogram.c --sample 100 --limit 1000000"
  echo "  cache-explore main.c --multi-file --json   # Compile with all .c files in dir"
  echo ""
  echo "Selective instrumentation examples:"
  echo "  cache-explore large.c --instrument-only hot_function  # Only profile hot_function"
  echo "  cache-explore main.c --exclude third_party            # Exclude third_party code"
}

OPT_LEVEL="-O0"
INPUT_FILES=()  # Array to collect multiple input files
CUSTOM_CONFIG_ARGS=""  # Custom cache config args to pass to cache-sim

while [[ $# -gt 0 ]]; do
  case "$1" in
    --config|--hardware) CONFIG="$2"; shift 2 ;;
    --verbose) VERBOSE="--verbose"; shift ;;
    --keep) KEEP_BINARY="1"; shift ;;
    --json) JSON_OUTPUT="--json"; shift ;;
    --stream) STREAM_OUTPUT="--stream"; shift ;;
    --multi-file) MULTI_FILE="1"; shift ;;
    --sample) SAMPLE_RATE="$2"; shift 2 ;;
    --limit) EVENT_LIMIT="$2"; shift 2 ;;
    --prefetch) PREFETCH="$2"; shift 2 ;;
    --prefetch-degree) PREFETCH_DEGREE="$2"; shift 2 ;;
    --compiler) COMPILER_PATH="$2"; shift 2 ;;
    --fast) FAST_MODE="--fast"; shift ;;
    --cache-segments) CACHE_SEGMENTS="--cache-segments"; shift ;;
    --instrument-only) INSTRUMENT_ONLY+=("$2"); shift 2 ;;
    --exclude) EXCLUDE_PATTERNS+=("$2"); shift 2 ;;
    --l1-size) CUSTOM_CONFIG_ARGS="$CUSTOM_CONFIG_ARGS --l1-size $2"; shift 2 ;;
    --l1-assoc) CUSTOM_CONFIG_ARGS="$CUSTOM_CONFIG_ARGS --l1-assoc $2"; shift 2 ;;
    --l1-line) CUSTOM_CONFIG_ARGS="$CUSTOM_CONFIG_ARGS --l1-line $2"; shift 2 ;;
    --l2-size) CUSTOM_CONFIG_ARGS="$CUSTOM_CONFIG_ARGS --l2-size $2"; shift 2 ;;
    --l2-assoc) CUSTOM_CONFIG_ARGS="$CUSTOM_CONFIG_ARGS --l2-assoc $2"; shift 2 ;;
    --l3-size) CUSTOM_CONFIG_ARGS="$CUSTOM_CONFIG_ARGS --l3-size $2"; shift 2 ;;
    --l3-assoc) CUSTOM_CONFIG_ARGS="$CUSTOM_CONFIG_ARGS --l3-assoc $2"; shift 2 ;;
    -O*) OPT_LEVEL="$1"; shift ;;
    -D) DEFINES+=("-D$2"); shift 2 ;;
    -D*) DEFINES+=("$1"); shift ;;
    -I) INCLUDES+=("-I$2"); shift 2 ;;
    -I*) INCLUDES+=("$1"); shift ;;
    --help) usage; exit 0 ;;
    -*) echo "Unknown option: $1"; usage; exit 1 ;;
    *) INPUT_FILES+=("$1"); shift ;;
  esac
done

# For backwards compatibility, set INPUT_FILE to first file
INPUT_FILE="${INPUT_FILES[0]:-}"

if [[ -z "$INPUT_FILE" ]]; then
  echo "Error: No input file specified"
  usage
  exit 1
fi

if [[ ! -f "$INPUT_FILE" ]]; then
  echo "Error: File not found: $INPUT_FILE"
  exit 1
fi

# Check dependencies - resolve pass (supports local build, cached, or download)
if ! resolve_pass; then
  exit 1
fi
PASS="$RESOLVED_PASS"
export CACHE_EXPLORER_PASS="$PASS"

if [[ ! -f "$RUNTIME" ]]; then
  echo "Error: Runtime not built. Run: ./scripts/build.sh"
  exit 1
fi

if [[ ! -f "$CACHE_SIM" ]]; then
  echo "Error: Cache simulator not built. Run: ./scripts/build.sh"
  exit 1
fi

# Find clang - prefer --compiler flag, then env, then versioned (CI), then unversioned (local)
find_clang() {
  find_upstream_clang
}

find_clangxx() {
  find_upstream_clangxx
}

# Find LLVM bin directory (for opt, llc, etc.)
find_llvm_bin() {
  # Check --compiler flag (path to LLVM bin directory)
  if [[ -n "$COMPILER_PATH" && -d "$COMPILER_PATH" ]]; then
    echo "$COMPILER_PATH"
    return
  fi
  # Try to find from the selected upstream clang location.
  local clang_path
  clang_path="$(find_upstream_clang 2>/dev/null || true)"
  clang_path="$(command -v "$clang_path" 2>/dev/null || echo "$clang_path")"
  if [[ -n "$clang_path" ]]; then
    dirname "$clang_path"
    return
  fi
  # Check common homebrew locations
  for dir in /opt/homebrew/opt/llvm/bin /opt/homebrew/opt/llvm@20/bin /usr/local/opt/llvm/bin; do
    if [[ -d "$dir" && -x "$dir/opt" ]]; then
      echo "$dir"
      return
    fi
  done
  # Check versioned paths (Ubuntu)
  for ver in 21 20 19 18 17 16 15; do
    if [[ -d "/usr/lib/llvm-$ver/bin" ]]; then
      echo "/usr/lib/llvm-$ver/bin"
      return
    fi
  done
  # Fallback - assume tools are in PATH
  echo ""
}

# Detect language from file extension
EXT="${INPUT_FILE##*.}"
case "$EXT" in
  c)
    LANG="c"
    COMPILER="$(find_clang)"
    BASENAME=$(basename "$INPUT_FILE" .c)
    ;;
  cpp|cc|cxx|C)
    LANG="c++"
    COMPILER="$(find_clangxx)"
    BASENAME=$(basename "$INPUT_FILE" ."$EXT")
    ;;
  rs)
    LANG="rust"
    COMPILER="rustc"
    BASENAME=$(basename "$INPUT_FILE" .rs)
    ;;
  zig)
    # Delegate to cache-explore-zig wrapper with reconstructed args
    ZIG_ARGS=("$INPUT_FILE")
    [[ -n "$CONFIG" ]] && ZIG_ARGS+=(--config "$CONFIG")
    [[ -n "$JSON_OUTPUT" ]] && ZIG_ARGS+=("$JSON_OUTPUT")
    [[ -n "$STREAM_OUTPUT" ]] && ZIG_ARGS+=("$STREAM_OUTPUT")
    [[ -n "$VERBOSE" ]] && ZIG_ARGS+=("$VERBOSE")
    [[ -n "$FAST_MODE" ]] && ZIG_ARGS+=("$FAST_MODE")
    exec "$SCRIPT_DIR/cache-explore-zig" "${ZIG_ARGS[@]}"
    ;;
  *)
    echo "Error: Unsupported file extension: .$EXT"
    echo "Supported: .c, .cpp, .cc, .cxx, .rs, .zig"
    exit 1
    ;;
esac

BINARY="/tmp/cache-explore-$$-$BASENAME"

enrich_json_output() {
  local defines_list=""
  local includes_list=""

  if [[ ${#DEFINES[@]} -gt 0 ]]; then
    defines_list="$(printf '%s\n' "${DEFINES[@]}")"
  fi
  if [[ ${#INCLUDES[@]} -gt 0 ]]; then
    includes_list="$(printf '%s\n' "${INCLUDES[@]}")"
  fi

  CACHE_EXPLORER_RESULT_KIND="simulated" \
  CACHE_EXPLORER_EXECUTOR="cli" \
  CACHE_EXPLORER_SOURCE="$INPUT_FILE" \
  CACHE_EXPLORER_LANGUAGE="$LANG" \
  CACHE_EXPLORER_CONFIG="$CONFIG" \
  CACHE_EXPLORER_OPT_LEVEL="$OPT_LEVEL" \
  CACHE_EXPLORER_DEFINES="$defines_list" \
  CACHE_EXPLORER_INCLUDES="$includes_list" \
  CACHE_EXPLORER_SAMPLE_RATE="${SAMPLE_RATE:-1}" \
  CACHE_EXPLORER_EVENT_LIMIT="${EVENT_LIMIT:-0}" \
  CACHE_EXPLORER_PREFETCH="${PREFETCH:-none}" \
  CACHE_EXPLORER_PREFETCH_DEGREE="${PREFETCH_DEGREE:-0}" \
  CACHE_EXPLORER_FAST_MODE="$FAST_MODE" \
  CACHE_EXPLORER_CACHE_SEGMENTS="$CACHE_SEGMENTS" \
  CACHE_EXPLORER_COMPILER="$COMPILER" \
  CACHE_EXPLORER_PASS="$PASS" \
  CACHE_EXPLORER_RUNTIME="$RUNTIME" \
  CACHE_EXPLORER_SIM="$CACHE_SIM" \
  CACHE_EXPLORER_CLI="$SCRIPT_DIR/cache-explore" \
  CACHE_EXPLORER_PROJECT_ROOT="$PROJECT_ROOT" \
  "$SCRIPT_DIR/cache-explore-enrich-json"
}

if [[ -z "$JSON_OUTPUT" ]]; then
  echo "=== Hardware Explorer Preview ===" >&2
  echo "Input: $INPUT_FILE" >&2
  echo "Language: $LANG" >&2
  echo "Config: $CONFIG" >&2
  echo "" >&2
fi
# Always emit stage markers to stderr (server parses these for progress)
echo "[1/3] Compiling with instrumentation..." >&2

EXTRA_FLAGS=""
if [[ "$OPT_LEVEL" == "-O0" ]]; then
  EXTRA_FLAGS="-Xclang -disable-O0-optnone"
fi

# Get the input directory
INPUT_DIR="$(dirname "$INPUT_FILE")"

# Collect source files
SOURCE_FILES=()

if [[ ${#INPUT_FILES[@]} -gt 1 ]]; then
  # Multiple files explicitly passed on command line
  SOURCE_FILES=("${INPUT_FILES[@]}")
elif [[ -n "$MULTI_FILE" ]]; then
  # Explicit multi-file mode: collect all source files from the directory
  for file in "$INPUT_DIR"/*.c "$INPUT_DIR"/*.cpp "$INPUT_DIR"/*.cc "$INPUT_DIR"/*.cxx; do
    [[ -e "$file" ]] && SOURCE_FILES+=("$file")
  done
else
  # Auto-detect multi-file mode: if the directory contains multiple .c files
  # and looks like a temp directory (created by the server), enable it automatically
  c_file_count=$(shopt -s nullglob; files=("$INPUT_DIR"/*.c); echo ${#files[@]})
  if [[ $c_file_count -gt 1 ]] && [[ "$INPUT_DIR" =~ ^/tmp/cache-explorer- ]]; then
    # Auto-enable multi-file mode for temp directories with multiple .c files
    for file in "$INPUT_DIR"/*.c "$INPUT_DIR"/*.cpp "$INPUT_DIR"/*.cc "$INPUT_DIR"/*.cxx; do
      [[ -e "$file" ]] && SOURCE_FILES+=("$file")
    done
  fi
fi

# Fallback: if no source files collected, just use the input file
if [[ ${#SOURCE_FILES[@]} -eq 0 ]]; then
  SOURCE_FILES=("$INPUT_FILE")
fi

# Build environment variables for selective instrumentation (used by both Rust and C/C++)
PASS_ENV=""
if [[ ${#INSTRUMENT_ONLY[@]} -gt 0 ]]; then
  # Join array with commas
  PATTERNS=$(IFS=,; echo "${INSTRUMENT_ONLY[*]}")
  PASS_ENV="CACHE_EXPLORER_INSTRUMENT_ONLY=$PATTERNS $PASS_ENV"
fi
if [[ ${#EXCLUDE_PATTERNS[@]} -gt 0 ]]; then
  PATTERNS=$(IFS=,; echo "${EXCLUDE_PATTERNS[*]}")
  PASS_ENV="CACHE_EXPLORER_EXCLUDE=$PATTERNS $PASS_ENV"
fi

# Compile based on language
if [[ "$LANG" == "rust" ]]; then
  # Check if code uses no_std (simple heuristic)
  if grep -q '#!\[no_std\]' "$INPUT_FILE"; then
    RUST_MODE="no_std"
  else
    RUST_MODE="std"
  fi

  # Find LLVM tools directory
  LLVM_BIN="$(find_llvm_bin)"
  if [[ -z "$LLVM_BIN" ]]; then
    OPT_CMD="opt"
    LLC_CMD="llc"
    CLANG_CMD="clang"
  else
    OPT_CMD="$LLVM_BIN/opt"
    LLC_CMD="$LLVM_BIN/llc"
    CLANG_CMD="$LLVM_BIN/clang"
  fi

  # Verify LLVM tools exist
  if ! command -v "$OPT_CMD" &>/dev/null && [[ ! -x "$OPT_CMD" ]]; then
    if [[ -n "$JSON_OUTPUT" ]]; then
      echo "{\"error\": \"LLVM opt not found\", \"details\": \"Install LLVM for Rust support\"}"
    else
      echo "Error: LLVM 'opt' not found. Rust support requires LLVM tools (opt, llc)." >&2
    fi
    exit 1
  fi

  if [[ "$RUST_MODE" == "std" ]]; then
    # === STD RUST: IR pipeline (same as no_std and Zig) ===
    # rustc --emit=llvm-ir emits just the user crate's IR with external std refs.
    # We apply our pass with system opt (not rustc's bundled LLVM — avoids ABI mismatch).
    # @main is renamed to @__ce_user_main to avoid symbol conflict with the stub.
    # rustc compiles the stub + links our .o, handling all sysroot/std paths automatically.
    RUST_IR="/tmp/cache-explore-rust-$$.ll"
    RUST_INSTRUMENTED="/tmp/cache-explore-rust-instrumented-$$.ll"
    RUST_RENAMED="/tmp/cache-explore-rust-renamed-$$.ll"
    RUST_OBJ="/tmp/cache-explore-rust-$$.o"
    RUST_STUB="/tmp/cache-explore-rust-stub-$$.rs"

    # Step 1: Compile Rust to LLVM IR
    if ! rustc --edition 2021 -C opt-level=0 -C panic=abort -g --emit=llvm-ir \
      -o "$RUST_IR" "$INPUT_FILE" 2>/tmp/cache-explore-compile-err-$$; then
      if [[ -n "$JSON_OUTPUT" ]]; then
        ESCAPED=$(cat /tmp/cache-explore-compile-err-$$ | python3 -c "import sys,json; print(json.dumps(sys.stdin.read())[1:-1])")
        echo "{\"error\": \"Rust compilation failed\", \"details\": \"$ESCAPED\"}"
      else
        echo "Rust compilation to IR failed:" >&2
        cat /tmp/cache-explore-compile-err-$$ >&2
      fi
      rm -f /tmp/cache-explore-compile-err-$$ "$RUST_IR"
      exit 1
    fi

    # Step 2: Run LLVM pass on the IR (with environment variables)
    if ! env $PASS_ENV "$OPT_CMD" -load-pass-plugin="$PASS" -passes="cache-explorer-module" \
      -S "$RUST_IR" -o "$RUST_INSTRUMENTED" 2>/tmp/cache-explore-compile-err-$$; then
      if [[ -n "$JSON_OUTPUT" ]]; then
        ESCAPED=$(cat /tmp/cache-explore-compile-err-$$ | python3 -c "import sys,json; print(json.dumps(sys.stdin.read())[1:-1])")
        echo "{\"error\": \"LLVM pass failed\", \"details\": \"$ESCAPED\"}"
      else
        echo "LLVM instrumentation pass failed:" >&2
        cat /tmp/cache-explore-compile-err-$$ >&2
      fi
      rm -f /tmp/cache-explore-compile-err-$$ "$RUST_IR" "$RUST_INSTRUMENTED"
      exit 1
    fi

    # Step 3: Rename @main -> @__ce_user_main to avoid symbol conflict with the stub
    sed 's/@main(/@__ce_user_main(/g' "$RUST_INSTRUMENTED" > "$RUST_RENAMED"

    # Step 4: Compile instrumented IR to object file
    if ! "$LLC_CMD" -filetype=obj -o "$RUST_OBJ" "$RUST_RENAMED" 2>/tmp/cache-explore-compile-err-$$; then
      if [[ -n "$JSON_OUTPUT" ]]; then
        ESCAPED=$(cat /tmp/cache-explore-compile-err-$$ | python3 -c "import sys,json; print(json.dumps(sys.stdin.read())[1:-1])")
        echo "{\"error\": \"LLVM compilation failed\", \"details\": \"$ESCAPED\"}"
      else
        echo "LLVM IR to object compilation failed:" >&2
        cat /tmp/cache-explore-compile-err-$$ >&2
      fi
      rm -f /tmp/cache-explore-compile-err-$$ "$RUST_IR" "$RUST_INSTRUMENTED" "$RUST_RENAMED" "$RUST_OBJ"
      exit 1
    fi

    # Step 5: Write stub that calls into our instrumented entry point
    # rustc compiles this and handles all std/sysroot linking automatically.
    # Works for both fn main() and fn main(i32, ptr) signatures since we
    # always call with (0, null) and extra C args are safely ignored.
    cat > "$RUST_STUB" << 'STUB_EOF'
extern "C" { fn __ce_user_main(argc: i32, argv: *const *const u8) -> i32; }
fn main() { unsafe { std::process::exit(__ce_user_main(0, std::ptr::null())); } }
STUB_EOF

    # Step 6: Compile stub and link with our instrumented object + runtime
    if ! rustc --edition 2021 -C panic=abort "$RUST_STUB" \
      -C link-arg="$RUST_OBJ" \
      -C link-arg="$RUNTIME" \
      -o "$BINARY" 2>/tmp/cache-explore-compile-err-$$; then
      if [[ -n "$JSON_OUTPUT" ]]; then
        ESCAPED=$(cat /tmp/cache-explore-compile-err-$$ | python3 -c "import sys,json; print(json.dumps(sys.stdin.read())[1:-1])")
        echo "{\"error\": \"Linking failed\", \"details\": \"$ESCAPED\"}"
      else
        echo "Linking failed:" >&2
        cat /tmp/cache-explore-compile-err-$$ >&2
      fi
      rm -f /tmp/cache-explore-compile-err-$$ "$RUST_IR" "$RUST_INSTRUMENTED" "$RUST_RENAMED" "$RUST_OBJ" "$RUST_STUB"
      exit 1
    fi

    # Cleanup intermediate files
    rm -f "$RUST_IR" "$RUST_INSTRUMENTED" "$RUST_RENAMED" "$RUST_OBJ" "$RUST_STUB" /tmp/cache-explore-compile-err-$$

  else
    # === NO_STD RUST: Direct compilation pipeline ===
    RUST_IR="/tmp/cache-explore-rust-$$.ll"
    RUST_INSTRUMENTED="/tmp/cache-explore-rust-instrumented-$$.ll"
    RUST_OBJ="/tmp/cache-explore-rust-$$.o"

    # Step 1: Compile Rust to LLVM IR
    if ! rustc --edition 2021 -C opt-level=1 -C panic=abort \
      -C debug-assertions=no -C overflow-checks=no -g --emit=llvm-ir \
      -o "$RUST_IR" "$INPUT_FILE" 2>/tmp/cache-explore-compile-err-$$; then
      if [[ -n "$JSON_OUTPUT" ]]; then
        ESCAPED=$(cat /tmp/cache-explore-compile-err-$$ | python3 -c "import sys,json; print(json.dumps(sys.stdin.read())[1:-1])")
        echo "{\"error\": \"Rust compilation failed\", \"details\": \"$ESCAPED\"}"
      else
        echo "Rust compilation to IR failed:" >&2
        cat /tmp/cache-explore-compile-err-$$ >&2
      fi
      rm -f /tmp/cache-explore-compile-err-$$ "$RUST_IR"
      exit 1
    fi

    # Step 2: Run LLVM pass on the IR (with environment variables)
    if ! env $PASS_ENV "$OPT_CMD" -load-pass-plugin="$PASS" -passes="cache-explorer-module" \
      -S "$RUST_IR" -o "$RUST_INSTRUMENTED" 2>/tmp/cache-explore-compile-err-$$; then
      if [[ -n "$JSON_OUTPUT" ]]; then
        ESCAPED=$(cat /tmp/cache-explore-compile-err-$$ | python3 -c "import sys,json; print(json.dumps(sys.stdin.read())[1:-1])")
        echo "{\"error\": \"LLVM pass failed\", \"details\": \"$ESCAPED\"}"
      else
        echo "LLVM instrumentation pass failed:" >&2
        cat /tmp/cache-explore-compile-err-$$ >&2
      fi
      rm -f /tmp/cache-explore-compile-err-$$ "$RUST_IR" "$RUST_INSTRUMENTED"
      exit 1
    fi

    # Step 3: Compile instrumented IR to object file
    if ! "$LLC_CMD" -filetype=obj -o "$RUST_OBJ" "$RUST_INSTRUMENTED" 2>/tmp/cache-explore-compile-err-$$; then
      if [[ -n "$JSON_OUTPUT" ]]; then
        ESCAPED=$(cat /tmp/cache-explore-compile-err-$$ | python3 -c "import sys,json; print(json.dumps(sys.stdin.read())[1:-1])")
        echo "{\"error\": \"LLVM compilation failed\", \"details\": \"$ESCAPED\"}"
      else
        echo "LLVM IR to object compilation failed:" >&2
        cat /tmp/cache-explore-compile-err-$$ >&2
      fi
      rm -f /tmp/cache-explore-compile-err-$$ "$RUST_IR" "$RUST_INSTRUMENTED" "$RUST_OBJ"
      exit 1
    fi

    # Step 4: Link with runtime library
    if ! "$CLANG_CMD" "$RUST_OBJ" "$RUNTIME" -lpthread -ldl -lm \
      -o "$BINARY" 2>/tmp/cache-explore-compile-err-$$; then
      if [[ -n "$JSON_OUTPUT" ]]; then
        ESCAPED=$(cat /tmp/cache-explore-compile-err-$$ | python3 -c "import sys,json; print(json.dumps(sys.stdin.read())[1:-1])")
        echo "{\"error\": \"Linking failed\", \"details\": \"$ESCAPED\"}"
      else
        echo "Linking failed:" >&2
        cat /tmp/cache-explore-compile-err-$$ >&2
      fi
      rm -f /tmp/cache-explore-compile-err-$$ "$RUST_IR" "$RUST_INSTRUMENTED" "$RUST_OBJ"
      exit 1
    fi

    # Cleanup intermediate files
    rm -f "$RUST_IR" "$RUST_INSTRUMENTED" "$RUST_OBJ" /tmp/cache-explore-compile-err-$$
  fi  # End of std/no_std conditional

elif ! env $PASS_ENV $COMPILER $OPT_LEVEL $EXTRA_FLAGS -g -fpass-plugin="$PASS" \
  -I"$RUNTIME_INC" \
  "${INCLUDES[@]}" \
  "${DEFINES[@]}" \
  "${SOURCE_FILES[@]}" \
  "$RUNTIME" \
  -o "$BINARY" 2>/tmp/cache-explore-compile-err-$$; then
  if [[ -n "$JSON_OUTPUT" ]]; then
    # Properly escape JSON: preserve newlines as \n, escape quotes
    ESCAPED=$(cat /tmp/cache-explore-compile-err-$$ | python3 -c "import sys,json; print(json.dumps(sys.stdin.read())[1:-1])")
    echo "{\"error\": \"Compilation failed\", \"details\": \"$ESCAPED\"}"
  else
    echo "Compilation failed:" >&2
    cat /tmp/cache-explore-compile-err-$$ >&2
  fi
  rm -f /tmp/cache-explore-compile-err-$$
  exit 1
fi
rm -f /tmp/cache-explore-compile-err-$$

# Always emit stage markers to stderr (server parses these for progress)
echo "[2/2] Simulating cache behavior..." >&2

# Build environment for runtime options
RUN_ENV=""
if [[ -n "$SAMPLE_RATE" ]]; then
  RUN_ENV="CACHE_EXPLORER_SAMPLE_RATE=$SAMPLE_RATE $RUN_ENV"
fi
if [[ -n "$EVENT_LIMIT" ]]; then
  RUN_ENV="CACHE_EXPLORER_MAX_EVENTS=$EVENT_LIMIT $RUN_ENV"
fi

# Build prefetch flags for cache-sim
PREFETCH_ARG=""
if [[ -n "$PREFETCH" ]]; then
  PREFETCH_ARG="--prefetch $PREFETCH"
  # Default to aggressive prefetching (4 lines) to match Intel hardware
  if [[ -n "$PREFETCH_DEGREE" ]]; then
    PREFETCH_ARG="$PREFETCH_ARG --prefetch-degree $PREFETCH_DEGREE"
  else
    PREFETCH_ARG="$PREFETCH_ARG --prefetch-degree 4"
  fi
fi

# Streaming mode: pipe directly for real-time output
if [[ -n "$STREAM_OUTPUT" ]]; then
  if [[ -n "$RUN_ENV" ]]; then
    env $RUN_ENV "$BINARY" 2>&1 | "$CACHE_SIM" --config "$CONFIG" $STREAM_OUTPUT $PREFETCH_ARG $FAST_MODE $CACHE_SEGMENTS $CUSTOM_CONFIG_ARGS
  else
    "$BINARY" 2>&1 | "$CACHE_SIM" --config "$CONFIG" $STREAM_OUTPUT $PREFETCH_ARG $FAST_MODE $CACHE_SEGMENTS $CUSTOM_CONFIG_ARGS
  fi
  EXIT_CODE=${PIPESTATUS[0]}
elif [[ -n "$JSON_OUTPUT" ]]; then
  if [[ -n "$RUN_ENV" ]]; then
    env $RUN_ENV "$BINARY" | "$CACHE_SIM" --config "$CONFIG" $VERBOSE $JSON_OUTPUT $PREFETCH_ARG $FAST_MODE $CACHE_SEGMENTS $CUSTOM_CONFIG_ARGS | enrich_json_output
  else
    "$BINARY" | "$CACHE_SIM" --config "$CONFIG" $VERBOSE $JSON_OUTPUT $PREFETCH_ARG $FAST_MODE $CACHE_SEGMENTS $CUSTOM_CONFIG_ARGS | enrich_json_output
  fi
  EXIT_CODE=${PIPESTATUS[0]}
else
  # Pipe binary stdout directly to cache-sim (avoids storing trace in memory)
  # Binary stderr passes through to our stderr (server reads progress from it)
  if [[ -n "$RUN_ENV" ]]; then
    env $RUN_ENV "$BINARY" | "$CACHE_SIM" --config "$CONFIG" $VERBOSE $JSON_OUTPUT $PREFETCH_ARG $FAST_MODE $CACHE_SEGMENTS $CUSTOM_CONFIG_ARGS
  else
    "$BINARY" | "$CACHE_SIM" --config "$CONFIG" $VERBOSE $JSON_OUTPUT $PREFETCH_ARG $FAST_MODE $CACHE_SEGMENTS $CUSTOM_CONFIG_ARGS
  fi
  EXIT_CODE=${PIPESTATUS[0]}
fi

# Cleanup
if [[ -z "$KEEP_BINARY" ]]; then
  rm -f "$BINARY"
fi
