# Cache Explorer production/server environment template.
# Copy to your deployment secret store or local .env; do not commit real secrets.

# Server bind
NODE_ENV=production
HOST=0.0.0.0
PORT=3001

# Reverse proxy / hosted mode
# Set when requests arrive through nginx, a load balancer, or another proxy.
TRUST_PROXY=1

# Execution posture
# Public deployments should prefer sandbox mode once the sandbox image is built.
ENABLE_SANDBOX=1

# Request and process limits
RATE_LIMIT_RPM=30
RATE_LIMIT_WINDOW=60000
MAX_CONCURRENT_PROCESSES=5

# Timeouts
TIMEOUT_DEFAULT=60000
TIMEOUT_MIN=5000
TIMEOUT_MAX=300000
TIMEOUT_COMPILATION=30000
HEARTBEAT_INTERVAL=5000

# Streaming and memory safety
MAX_OUTPUT_BUFFER=52428800
MAX_EVENT_BATCH=1000
STREAM_BATCH_SIZE=100
STREAM_BATCH_INTERVAL=100
PROGRESS_INTERVAL=1000

# Temp cleanup
TEMP_DIR_MAX_AGE=300000
ORPHAN_CHECK_INTERVAL=60000

# Workload history and verification
# Keep stress workloads opt-in; do not set --include-stress in default jobs.
CACHE_EXPLORER_WORKLOAD_VARIANT_TIMEOUT_MS=120000
CACHE_EXPLORER_WORKLOAD_HISTORY_TIMEOUT=5000
# CACHE_EXPLORER_DASHBOARD_BASE_URL=https://owner.github.io/Cache-Explorer
# CACHE_EXPLORER_WORKLOAD_HISTORY_SUMMARY_PATH=reports/workloads/workload-history-summary.json

# Optional explicit CLI path if auto-detection is not enough.
# CACHE_EXPLORE_PATH=/app/backend/scripts/cache-explore
