{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AveryClapp/Cache-Explorer/hardware-explorer-hotspots-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "hardware-explorer-hotspots"
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "traceFormat": {
          "const": 2
        },
        "kind": {
          "enum": [
            "clang-cl",
            "intel-pin"
          ]
        },
        "target": {
          "const": "i686-pc-windows-msvc"
        },
        "addressWidth": {
          "const": 32
        },
        "sampleRate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "eventLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000000
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "traceFormat",
        "kind",
        "target",
        "addressWidth",
        "sampleRate",
        "eventLimit",
        "truncated"
      ]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^/\\\\:\\u0000-\\u001f\\u007f]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^/\\\\:\\u0000-\\u001f\\u007f]+$"
        },
        "modelConfidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^/\\\\:\\u0000-\\u001f\\u007f]+$"
        },
        "configuration": {
          "type": "object",
          "maxProperties": 128,
          "propertyNames": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9.]{0,100}$"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "maxLength": 128,
                "pattern": "^[a-zA-Z0-9 -]+$"
              }
            ]
          }
        }
      },
      "required": [
        "id",
        "displayName",
        "modelConfidence",
        "configuration"
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "const": "exported-ranked-sites"
        },
        "returnedSites": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "note": {
          "const": "Ranked subset, not complete module/function totals. Unattributed accesses are not represented."
        }
      },
      "required": [
        "scope",
        "returnedSites",
        "note"
      ]
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "$ref": "#/definitions/image"
      }
    },
    "codeHotspots": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/definitions/hotspot"
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
      }
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "capture",
    "profile",
    "coverage",
    "images",
    "codeHotspots",
    "warnings"
  ],
  "definitions": {
    "rva": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{1,8}$"
    },
    "imageId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/imageId"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^/\\\\:\\u0000-\\u001f\\u007f]+$"
        },
        "imageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "codeView": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "guid": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "age": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          },
          "required": [
            "guid",
            "age"
          ]
        }
      },
      "required": [
        "id",
        "sha256",
        "name",
        "imageSize"
      ]
    },
    "hotspot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "location": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "imageId": {
              "$ref": "#/definitions/imageId"
            },
            "rva": {
              "$ref": "#/definitions/rva"
            }
          },
          "required": [
            "imageId",
            "rva"
          ]
        },
        "lookup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rva": {
              "$ref": "#/definitions/rva"
            },
            "method": {
              "enum": [
                "instruction-pc",
                "return-pc-minus-one"
              ]
            }
          },
          "required": [
            "rva",
            "method"
          ]
        },
        "navigationConfidence": {
          "enum": [
            "unresolved",
            "source-nearest",
            "function-exact"
          ]
        },
        "symbol": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "function": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "functionRva": {
              "$ref": "#/definitions/rva"
            }
          },
          "required": [
            "function",
            "functionRva"
          ]
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "accesses": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "reads": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "writes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "l1dHits": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "l1dMisses": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "l1dMissRate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "estimatedMemoryStallCycles": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "accesses",
            "reads",
            "writes",
            "l1dHits",
            "l1dMisses",
            "l1dMissRate",
            "estimatedMemoryStallCycles"
          ]
        }
      },
      "required": [
        "location",
        "lookup",
        "navigationConfidence",
        "metrics"
      ]
    }
  }
}
